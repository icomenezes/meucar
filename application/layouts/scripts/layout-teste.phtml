<script type="text/javascript">
// Modal logic using the global jQuery identifier (avoids $ conflicts)
jQuery(document).ready(function(){
	jQuery('#trocar_empresa_btn').on('click', function(e){
		e.preventDefault();
		// Carregar empresas via AJAX
		jQuery.ajax({
			type: 'GET',
			url: '/usuarios/ajax/fn/getEmpresas',
			dataType: 'json',
			success: function(response){
				console.log('Response:', response); // Debug
				if(response.sucesso){
					var html = '<option value="0">Selecione uma empresa</option>';
					jQuery.each(response.empresas, function(i, empresa){
						console.log('Empresa:', empresa); // Debug
						html += '<option value="' + empresa.id + '">ID: ' + empresa.id + ' - ' + empresa.nome_fantasia + '</option>';
					});
					jQuery('#modal_select_empresa').html(html);
					jQuery('#modalTrocarEmpresa').modal('show');
				}else{
					alert('Erro ao carregar empresas');
				}
			},
			error: function(xhr, status, error){
				console.log('Erro:', error, xhr); // Debug
				alert('Erro na requisição: ' + error);
			}
		});
	});
	jQuery('#confirmar_trocar_empresa').on('click', function(){
		var idEmpresa = jQuery('#modal_select_empresa').val();
		if(idEmpresa == '0'){
			alert('Selecione uma empresa');
			return false;
		}
		jQuery.ajax({
			type: 'POST',
			url: '/usuarios/ajax/fn/trocar-empresa/id_empresa/' + idEmpresa,
			dataType: 'json',
			success: function(response){
				if(response.sucesso){
					location.reload();
				}else{
					alert('Erro ao trocar de empresa: ' + response.mensagem);
				}
			},
			error: function(){
				alert('Erro na requisição');
			}
		});
	});
});
</script>
