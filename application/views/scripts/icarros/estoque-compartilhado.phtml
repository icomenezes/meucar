	foreach($this->veiculos as $key=>$veiculo){
		
		$coutCarros++;
		
		if($veiculo['marca'] != $this->veiculos[($key-1)]['marca']){
			
			echo "<tr><td class='marca' colspan='14'>".mb_convert_encoding($veiculo['marca'], 'UTF-8', 'ISO-8859-1')."</td></tr>";
		
		}
		
		if($veiculo['descricao_site']){
			
			$veiculo['modelo'] = $veiculo['descricao_site'];
		
		}

		if($veiculo['ativo']){
			
			$veiculo['ativo'] = "Sim";
		
		}else{
			
			$veiculo['ativo'] = "N&atilde;o";
		
		}
		
		if($veiculo['consignado']){
			
			$veiculo['consignado'] = "Sim";
		
		}else{
			
			$veiculo['consignado'] = "N&atilde;o";
		
		}
		
		if($veiculo['km'] == ""){
			
			$veiculo['km'] = 1;
		
		}
		
		if($veiculo['km'] == 0){
			
			$veiculo['km'] = 1;
		
		}
	
		if($veiculo['fotos'] == ""){
			
			$veiculo['fotos'] = 0;
		
		}
		
		
		echo "  <tr>
					<td>".$coutCarros."</td>
					<td>".substr($veiculo['modelo'],0,26)."</td>
					<td>".strtoupper($veiculo['placa'])."</td>
					<td>".$veiculo['cor']."</td>
					<td>".$veiculo['ano_fabricacao']."/".$veiculo['ano_modelo']."</td>
					<td>".$veiculo['km']."</td>
					<td style='text-align:center;'> <img width='15px' src='/images/info.png' title='OPCIONAIS:\n".$veiculo['opcionais']."'/></td>
					<td>R$ ".money_format("%i",$veiculo['valor_venda'])."</td>
					<td>".$veiculo['ativo']."</td>
					<td>".$veiculo['consignado']."</td>
					<td>".$veiculo['fotos']."</td>
					<td>".$veiculo['de']."</td>
