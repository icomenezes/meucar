						<input type='hidden' id='versao_".$veiculo['id']."' value='".$veiculo['versao_id']."' />
						<select id='".$veiculo['id']."' name='".$veiculo['id_icarros']."' title='Icarros' onchange='triagem(this.id);' onclick='ultimoPlano();'>
							<option value=''>N&atilde;o Anunciado</option>
							".$veiculo['id_plano_icarros']."
						</select>
					</td>
					<td>
						<select>
							<option value=''>Desenvolvimento</option>
						</select>
					</td>
				</tr>";
	
	}
	
	
?>


