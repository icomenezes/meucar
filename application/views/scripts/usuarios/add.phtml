<script type="text/javascript">


function verificaSenha(){

	let senha = $("#senha1").val();
	let erro = false;

	if(senha.match(/[A-Z]/g) != null){
		alteraClasse('maiuscula', true);
	}else{
		alteraClasse('maiuscula', false);
		erro = true;
	}

	if(senha.match(/[a-z]/g) != null){
		alteraClasse('minuscula', true);
	}else{
		alteraClasse('minuscula', false);
		erro = true;
	}

	if(senha.match(/[0-9]/g) != null){
		alteraClasse('numero', true);
	}else{
		alteraClasse('numero', false);
		erro = true;
	}

	if(senha.match(/[@ _.,;:#$%^><+=&/]/g) != null){
		alteraClasse('caracteres', true);
	}else{
		alteraClasse('caracteres', false);
		erro = true;
	}

	if(senha.length >= 8){
		alteraClasse('minimo_caracteres', true);
	}else{
		alteraClasse('minimo_caracteres', false);
		erro = true;
	}

	if($("#senha1").val() == $("#senha2").val()){
		alteraClasse('iguais', true);
	}else{
		alteraClasse('iguais', false);
		erro = true;
	}

	return erro;

}

function alteraClasse(id, valid){
	if(valid){
		$("#"+id).removeClass("error");
		$("#"+id).addClass("sucesso");
	}else{
		$("#"+id).removeClass("sucesso");
		$("#"+id).addClass("error");
	}
}


function preview(input){

	var reader = new FileReader();

	reader.onload = function(e){

		$("#preview_img").attr("src",e.target.result);
	
	};
        
	reader.readAsDataURL(input.files[0]);

}

function validaCampo(){
	
	var msg = "";
	var erro = false;
	
	if($("#id_perfil").val() == "0"){
		
		erro = true;
		
		msg += "<br>O campo perfil deve ser selecionado.";
	
	}
	
	if($("#nome").val() == ""){
		
		erro = true;
		
		msg += "<br>O campo nome deve ser preenchido.";
	
	}
	
	if($("#telefone").val() == ""){
		
		erro = true;
		
		msg += "<br>O campo telefone deve ser preenchido.";
	
	}
	
	if($("#id_perfi").val() != 0 && $("#id_empresa").val() == 0){
		
		erro = true;
		
		msg += "<br>Este perfil nescessita de uma concessionaria.";
	
	}
	
	if($("#id_perfil").val() != <?php echo FUNCIONARIO; ?>){
		
		if($("#login").val() == ''){
		
			erro = true;
			
			msg += "<br>O campo login deve ser preenchido.";
		
		}

		if(verificaSenha()){

			erro = true;
		
			msg += "<br>O campo senha deve ser preenchido.";
		
		}
		
	}

	if(erro){
		
		msg = msg.substr(4);
		$("#msg").removeClass('sucess');
		$("#msg").addClass('erro');
		$("#msg").html(msg);
	
	}else{
		
		$("form").submit();
	
	}

}

$(function(){

	$("#cpf").mask("999.999.999-99");
	$("#rg").mask("99.999.999-9");
	$("#valor_fixo_mensal").attr("onkeyup","validaMoedaBR(this.id)");
	$("#valor_fixo").attr("onkeyup","validaMoedaBR(this.id)");
	
	$('#telefone').focusout(function(){
    var phone, element;
    element = $(this);
    element.unmask();
    phone = element.val().replace(/\D/g, '');
    if(phone.length > 10) {
        element.mask("(99) 99999-999?9");
    } else {
        element.mask("(99) 9999-9999?9");
    }
	}).trigger('focusout');
	
	$('#celular').focusout(function(){
    var phone, element;
    element = $(this);
    element.unmask();
    phone = element.val().replace(/\D/g, '');
    if(phone.length > 10) {
        element.mask("(99) 99999-999?9");
    } else {
        element.mask("(99) 9999-9999?9");
    }
	}).trigger('focusout');
	
	
	if($("#msg").html().length > 0){
			
		if($("#msg").attr("class") == "msg" && $("#msg").html().substr(0 ,4) != "Erro"){
		
			$("#msg").addClass('sucess');
		
		}else{
		
			$("#msg").addClass('erro');
		
		}
	
	}
	
	$('#data_nascimento').focus(function(){
		$(this).calendario({
			target:'#data_nascimento'
		});
	});
	
	$('#data_contratacao').focus(function(){
		$(this).calendario({
			target:'#data_contratacao'
		});
	});

})

function ativaDivVend(destino, c){
	
	if(c == <?php echo VENDEDOR; ?> || c == <?php echo GERENTE; ?> || c == <?php echo SUPERVISOR; ?> || c == <?php echo CONCESSIONARIO; ?>){
		
		$("#funcionario").css('display','none');
		$("#"+destino).css('display','inline');
	
	}else{
	
		$("#"+destino).css('display','none');
	
	}

}

function ativaDivFunc(destino, c){
	
	if(c == <?php echo FUNCIONARIO; ?>){
		
		$("#"+destino).css('display','inline');
		$("#divLogin").css('display','none');
		$("#divSenha").css('display','none');
	
	}else{

		$("#"+destino).css('display','inline');
		$("#divLogin").css('display','inline');
		$("#divSenha").css('display','inline');
		
	}
	
}

</script>
