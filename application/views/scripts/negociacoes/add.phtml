function promissoria(valor,obj){

	if(valor == 4){

		$(obj).next().next().css("display","block");
	
	}else{
	
		$(obj).next().next().css("display","none");
	
	}

}

function geraPromissoria(obj){

	dataPromissoria = $(obj).parent().next().children().val();
	
	var datas = new Array();
	
	datas = dataPromissoria.split('/');
	
	dataPromissoria = datas[0]+"-"+datas[1]+"-"+datas[2];
	
	numPromissoria = $(obj).parent().next().next().children().val();
	valPromissoria = $(obj).parent().next().next().next().next().next().next().children().val();
	nomeCliente = $("#nome").val();
	cpfCliente = $("#cpf").val();
	enderecoCliente = $("#endereco").val();
	cidadeCliente = $("#cidade").val();
	estadoCliente = $("#estado").val();
	cepCliente = $("#cep").val();
	
	var msg = "";
	var erro = false;
	
	if(datas == ""){
		
		erro = true;
		
		msg += "<br>O campo data deve ser preenchido para gerar a impress&atilde;o.";
	
	}
	
	if(numPromissoria == ""){
		
		erro = true;
		
		msg += "<br>O campo n&uacute;mero deve ser preenchido para gerar a impress&atilde;o.";
	
	}
	
	if(valPromissoria == ""){
		
		erro = true;
		
		msg += "<br>O campo valor deve ser preenchido para gerar a impress&atilde;o.";
	
	}
	
	if(nomeCliente == ""){
		
		erro = true;
		
		msg += "<br>O campo nome da aba cliente deve ser preenchido para gerar a impress&atilde;o.";
	
	}
	
	if(cpfCliente == ""){
		
		erro = true;
		
		msg += "<br>O campo cpf da aba cliente deve ser preenchido para gerar a impress&atilde;o.";
	
	}
	
	if(enderecoCliente == ""){
		
		erro = true;
		
		msg += "<br>O campo endere&ccedil;o da aba cliente deve ser preenchido para gerar a impress&atilde;o.";
	
	}
	
	if(cidadeCliente == ""){
		
		erro = true;
		
		msg += "<br>O campo cidade da aba cliente deve ser preenchido para gerar a impress&atilde;o.";
	
	}
	
	if(estadoCliente == ""){
		
		erro = true;
		
		msg += "<br>O campo estado da aba cliente deve ser preenchido para gerar a impress&atilde;o.";
	
	}
	
	if(cepCliente == ""){
		
		erro = true;
		
		msg += "<br>O campo cep da aba cliente deve ser preenchido para gerar a impress&atilde;o.";
	
	}
	
	if(erro){
		
		msg = msg.substr(4);
		$("#msg").removeClass('sucess');
		$("#msg").addClass('erro');
		$("#msg").html(msg);
	
	}else{
	
		window.open("<?php echo URL ?>negociacoes/imprimir-promissoria/data_promissoria/"+dataPromissoria+"/num_promissoria/"+numPromissoria+"/valor_promissoria/"+valPromissoria+"/nome/"+nomeCliente+"/cpf/"+cpfCliente+"/endereco/"+enderecoCliente+"/cidade/"+cidadeCliente+"/estado/"+estadoCliente+"/cep/"+cepCliente);

	}
}

