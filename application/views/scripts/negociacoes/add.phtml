	function calculaResumo(){
	
		var valVenda = $("#valor_venda").val();	
		$("#valor_venda_resumo").val(valVenda);
		valVenda = valVenda.replace(".","");
		valVenda = valVenda.replace(",",".");
		valVenda = parseFloat(valVenda);
		
		var retor = moeda2float($("#retorno_resumo").val());
		
		$("#total_receita_resumo").val(float2moeda(valVenda+retor));
		receita = float2moeda(valVenda+retor);
		receita = receita.replace(".","");
		receita = receita.replace(",",".");
		receita = parseFloat(receita);
		/*
		var aquisicao = moeda2float($("#valor_aquisicao").val());
		$("#valor_aquisicao_resumo").val(float2moeda(aquisicao));
		*/
		var aquisicao = moeda2float($("#valor_aquisicao").val().replace(".",","));
		$("#valor_aquisicao_resumo").val(float2moeda(aquisicao));
		
		var despesas = moeda2float($("#despesas_negociacao tr:last td:last").html());
		$("#despesas_resumo").val(float2moeda(despesas));
		
		var transf = moeda2float($("#custos_transferencia").val());
		$("#transferencia_resumo").val(float2moeda(transf));
		
		var comissaoVendedor = $("#comissao_vendedor_real").val();
		if(comissaoVendedor == ""){
			comissaoVendedor = 0;
		}
		$("#comissao_vendedor_resumo").val(comissaoVendedor);
		comissaoVendedor = moeda2float(comissaoVendedor);
		
		var comissaoGerente = $("#comissao_gerente_real").val();
		if(comissaoGerente == ""){
			comissaoGerente = 0;
		}
		$("#comissao_gerente_resumo").val(comissaoGerente);
		comissaoGerente = moeda2float(comissaoGerente);
		
		var comissaoSupervisor = $("#comissao_supervisor_real").val();
		if(comissaoSupervisor == ""){
			comissaoSupervisor = 0;
		}
		$("#comissao_supervisor_resumo").val(comissaoSupervisor);
		comissaoSupervisor = moeda2float(comissaoSupervisor);
		
		totalDespesa = (aquisicao + despesas + transf + comissaoVendedor + comissaoGerente + comissaoSupervisor);
		$("#total_despesa_resumo").val(float2moeda(totalDespesa));
		
		totalGeral = receita - (aquisicao + despesas + transf + comissaoVendedor + comissaoGerente + comissaoSupervisor);
		$("#resultado_resumo").val(float2moeda(totalGeral));

	}


function validaCampo(){

	calcDiferenca();

	var msg = "";
	var erro = false;
	
	if($("#valor_venda").val() == ""){
		
		erro = true;
		
		msg += "<br>Na aba Ve&iacute;culo o campo valor deve ser preenchido.";
	
	}
	
	if($("#id_cliente").val() == ""){
		
		erro = true;
		
		msg += "<br>Na aba Cliente um cliente deve ser selecionado.";
	
	}
	
	if($("#origem").val() == ""){
		
		erro = true;

		msg += "<br>Na aba Cliente a Origem deve ser selecionado.";
	
	}
	
	if($("#id_financeira").val() != ""){
		
		if($("#valor_financiado").val() == ""){
		
			erro = true;
			
			msg += "<br>Na aba Recebimento o campo valor financiamento deve ser preenchido.";
	
		}
		
		if($("#retorno_financeira").val() == ""){
		
			erro = true;
			
			msg += "<br>Na aba Recebimento o campo retorno deve ser selecionado.";
	
		}

		/*
		if($("#coeficiente_financeira").val() == ""){
		
			erro = true;
			
			msg += "<br>Na aba Recebimento o campo coeficiente financeira deve ser preenchido.";
	
		}
		*/
		if($("#numero_prestacoes").val() == ""){
		
			erro = true;
			
			msg += "<br>Na aba Recebimento o campo num. presta&ccedil;&otilde;es deve ser preenchido.";
	
		}
		
		if($("#valor_prestacoes").val() == ""){
		
			erro = true;
			
			msg += "<br>Na aba Recebimento o campo valor presta&ccedil;&otilde;es deve ser preenchido.";
	
		}
	
	}
	
	$("#pgtos_programados input").each(function (){
		
		if($(this).attr('id').substr(0,5) == "Rdata"){
	
			if($(this).val() == ""){
	
				erro = true;
			
				msg += "<br>Na aba Recebimento o campo data deve ser preenchido.";
				
			}
			
		}
	
	});
	
	if($("#valor_base_calculo").val() == ""){
		
		erro = true;
			
		msg += "<br>Na aba Comiss&otilde;es o campo valor base para c&aacute;lculo de comiss&atilde;o deve ser preenchido.";
	
	}
	
	if($("#diferenca").val() != "0"){
		
		erro = true;
		
		msg += "<br>Existe uma diferenca entre o valor do ve&iacute;culo e os valores a serem pagos.";
	
	}
	
	if(erro){
		
		msg = msg.substr(4);
		$("#msg").removeClass('sucess');
		$("#msg").addClass('erro');
		$("#msg").html(msg);
		
		return false;
	
	}else{
	
		//salvaOrigem();
	
		$("input[readonly='readonly']").each(function(){
		
			if($(this).attr('id') != 'data_abertura' && $(this).attr('id') != 'comissao_vendedor' && $(this).attr('id') != 'comissao_gerente' && $(this).attr('id') != 'comissao_supervisor'){
		
				$(this).remove();
			
			}
			
		});
		
		$("textarea[readonly='readonly']").each(function(){
		
			$(this).remove();
			
		});
		
		
		
		
		$("form").submit();
		
		$("#bnt_cadastrar").remove();

		return true;
	
	}

}


