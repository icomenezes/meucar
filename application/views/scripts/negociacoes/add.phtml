function getComissoes(id, perfil){
	
	var arr = new Array();
	var v = $("#valor_base_calculo").val();
	
	if(id != ""){
	
		$.ajax({
			type: "POST",
			url: '/usuarios/ajax/fn/getComissoes',
			async: true,
			dataType:"text",
			data: ({'id':id}),
			success:function(resp){

				arr = resp.split("_");
				
				if(arr[0] != 0){

					comissao = arr[0];
					v = moeda2float(v);
					
					$("#comissao_"+perfil).val(float2moeda((comissao/v)*100));
					$("#comissao_"+perfil+"_real").val(float2moeda(arr[0]));
				
				}else{
					
					comissao = arr[1];
					v = moeda2float(v);

					$("#comissao_"+perfil+"_real").val(float2moeda((arr[1]*v)/100));
					$("#comissao_"+perfil).val(float2moeda(comissao));
					
				}

			}
		});
	
	}

}


function calculaPercComissaoVendedor(){

	var v = $("#valor_base_calculo").val();
	
	v = v.replace(".","");
	v = v.replace(",",".");
	real = $("#comissao_vendedor_real").val();
	real = real.replace(",",".");
	
	if(v > 0 && real.length > 0){

		var r = real*100/v;
		
		r = float2moeda(r);
		r = moeda2float(r);

		$("#comissao_vendedor").val(r);
	
	}else{
	
		if(v > 0 && $("#comissao_vendedor").val().length > 0){
			
			var r = $("#comissao_vendedor").val()*v/100;

			r = float2moeda(r);
			r = moeda2float(r);
	
			$("#comissao_vendedor_real").val(r);
	
		}
	
	}

}

