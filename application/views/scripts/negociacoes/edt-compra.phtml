function confirmaDeletePagamento(id){

	qtdElemento = 0;

decisao = confirm("Deseja realmente deletar?");
	
	if (decisao){
	
		var temElemento = true;
	
	
		$("#pgtos_programados tr td input").each(function(){
	
			if($(this).attr('id').substring(0,5) == "Rdata"){
	
				temElemento = false;
				qtdElemento++;
	
			}

		})

		if(qtdElemento > 1){
			
			$.ajax({
				type: "POST",
				url:"/negociacoes/ajax/fn/deleta_pagamento/id_pagamento/"+id,
				dataType:"html",                       
				success:function(retorno){
				
					if(retorno == "Sucesso"){
						
						$("#Rdata_"+id).parent().parent().remove();
						
						if(temElemento){
						
							$("#pgtos_programados").html("<tr id=\"recedimenros_0\"><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td><input type=\"button\" id=\"btn_0\" name=\"btn_0\" class=\"btn-mini btn-include\" value=\"Add\" onclick=\"adicionarPgto();\"></td></tr>");
						
						}
						
					}else{
					
						alert(retorno);
					
					}
			
				}
			})
			
						
		}else{
						
			alert("É necessário cadastrar no mínimo uma forma de pagamento!");
						
		}
		
	}
	
}

function ativaSubAba(destino, c){

	$("#subAbas td").each(function(){
		
		$(this).removeClass('selecionado');
		
	});
	
	$(c).parent().addClass('selecionado');
	
	var divAbas = new Array('cliente', 'venda', 'despesa', 'troca', 'transf', 'recebimento', 'comissoes', 'datas', 'resumo','aprovacao');

	for(x in divAbas){
		
		$("#"+divAbas[x]).css('display','none');
	
	}
	
	$("#"+destino).css('display','inline');
	
	var apro = "<?php echo $this->negociacao['aprovada'];?>";
	
	if(apro == "1"){
	
		$("#aprovar").click();
		
	}
	
	if(apro == "-1"){
	
		$("#reprovar").click();
	
	}
	
	atualizaCamposVenda();

}


