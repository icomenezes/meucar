	$("#Rdata_"+pgtosAdd).mask("99/99/9999");
	$('#Rdata_'+pgtosAdd).focus(function(){
		$(this).calendario({
			target:'#Rdata_'+pgtosAdd
		});
	});
	
	calcDiferenca();

}

