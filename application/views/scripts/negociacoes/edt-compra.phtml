<script type="text/javascript">


function buscaOrigemSelecionado(){

	$.ajax({
		url : '/clientes/ajax/fn/busca_origem_id',
		async: false,
		type : 'POST',
		data: ({'nome':$("#nome").val()}),
		dataType: 'text',
		success: function(data){

			var arr = new Array(2);
	
			arr = data.split("|");

			$("#origem option[value='"+arr[1]+"']").attr("selected", true);
			
			idFluxo = arr[0];

		}
	});

}

function  buscaOrigem(){

	$.ajax({
		url : '/clientes/ajax/fn/busca_origem',
		async: true,
		type : 'POST',
		dataType: 'text',
		success: function(data){

			$("#origem").html(data);
			
			//buscaOrigemSelecionado();
			
			populaCamposCliente(<?php echo $this->negociacao['id_cliente']; ?>);
			
		}
	});

}



function xmlNfeCliente(){
	
	var idCliente = $("#id_cliente").val(); 

	if(idCliente == ""){
		
		alert("Cliente não encontrado.");
	
	}else{

		window.location.href="/negociacoes/gera-xml-nfe-cliente/id_cliente/"+idCliente;

	}

}


function xmlNfeProduto(){
	
	var idVeiculo = $("#id_veiculo").val(); 

	if(idVeiculo == ""){
		
		alert("Veículo não encontrado.");
	
	}else{

		window.location.href="/negociacoes/gera-xml-nfe-produto/id_veiculo/"+idVeiculo;

	}

}



function aprovacoes(obj){

	if($(obj).attr('id') == "aprovar"){
	
		$(obj).css("background","#CCCCCC");
		$(obj).attr("value","Aprovado");
		$("#reprovar").attr("value","Reprovar");
		$("#reprovar").css("background","#EFEFEF");
		
		if("<?php echo $this->negociacao['data_concretizacao'] ?>" == "00/00/0000 00:00:00"){
		
			$("#data_concretizacao").val("<?php echo @date('d/m/Y H:i:s');?>");
		
		}
		
		$("#data_cancelamento").val("<?php echo '00/00/0000 00:00:00';?>");
		$("#aprovada").val("1");
	}
	
	if($(obj).attr('id') == "reprovar"){
	
		$(obj).css("background","#CCCCCC");
		$(obj).attr("value","Reprovado");
		$("#aprovar").attr("value","Aprovar");
		$("#aprovar").css("background","#EFEFEF");
		
		if("<?php echo $this->negociacao['data_cancelamento'] ?>" == "00/00/0000 00:00:00"){
		
			$("#data_cancelamento").val("<?php echo @date('d/m/Y H:i:s');?>");
			
		}
		
		$("#data_concretizacao").val("<?php echo '00/00/0000 00:00:00';?>");
		$("#aprovada").val("-1");
	
	}

}

function exibirContrato(){
	
	if(validaCampo()){
	
		var idCliente = $("#id_cliente").val();
		var idEmpresa = $("#id_empresa").val();
		var idVeiculo = $("#id_veiculo").val();
		var idNegociacao = <?php echo $this->idNegociacao;?>;
		
		pagina = "/contratos/seleciona-contrato/id_cliente/"+idCliente+"/id_empresa/"+idEmpresa+"/id_veiculo/"+idVeiculo+"/id_negociacao/"+idNegociacao;
		largura = 580;
		altura = 340;
		
		w = screen.width;
		h = screen.height;
		meio_w = w/2;
		meio_h = h/2;
		altura2 = altura/2;
		largura2 = largura/2;
		meio1 = meio_h-altura2;
		meio2 = meio_w-largura2;
		window.open(pagina,'','scrollbars=no,toolbar=no,location=no,directories=no,status=no, menubar=no,resizable=no,copyhistory=no,height=' + altura + ',width=' + largura + ',top='+meio1+',left='+meio2+''); 
	
	}
}

function promissoria(valor,obj){

	if(valor == 4){

		$(obj).next().next().css("display","inline-block");

	}else{

		$(obj).next().next().css("display","none");

	}

}

function geraPromissoria(obj){

	dataPromissoria = $(obj).parent().next().children().val();
	
	var datas = new Array();
	
	datas = dataPromissoria.split('/');
	
	dataPromissoria = datas[0]+"-"+datas[1]+"-"+datas[2];
	
	numPromissoria = $(obj).parent().next().next().children().val();
	valPromissoria = $(obj).parent().next().next().next().next().next().next().children().val();
	nomeCliente = $("#nome").val();
	cpfCliente = $("#cpf").val();
	enderecoCliente = $("#endereco").val();
	cidadeCliente = $("#cidade").val();
	estadoCliente = $("#estado").val();
	cepCliente = $("#cep").val();
	
	var msg = "";
	var erro = false;
	
	if(datas == ""){
		
		erro = true;
		
		msg += "<br>O campo data deve ser preenchido para gerar a impress&atilde;o.";
	
	}
	
	if(numPromissoria == ""){
		
		erro = true;
		
		msg += "<br>O campo n&uacute;mero deve ser preenchido para gerar a impress&atilde;o.";
	
	}
	
	if(valPromissoria == ""){
		
		erro = true;
		
		msg += "<br>O campo valor deve ser preenchido para gerar a impress&atilde;o.";
	
	}
	
	if(nomeCliente == ""){
		
		erro = true;
		
		msg += "<br>O campo nome da aba cliente deve ser preenchido para gerar a impress&atilde;o.";
	
	}
	
	if(cpfCliente == ""){
		
		erro = true;
		
		msg += "<br>O campo cpf da aba cliente deve ser preenchido para gerar a impress&atilde;o.";
	
	}
	
	if(enderecoCliente == ""){
		
		erro = true;
		
		msg += "<br>O campo endere&ccedil;o da aba cliente deve ser preenchido para gerar a impress&atilde;o.";
	
	}
	
	if(cidadeCliente == ""){
		
		erro = true;
		
		msg += "<br>O campo cidade da aba cliente deve ser preenchido para gerar a impress&atilde;o.";
	
	}
	
	if(estadoCliente == ""){
		
		erro = true;
		
		msg += "<br>O campo estado da aba cliente deve ser preenchido para gerar a impress&atilde;o.";
	
	}
	
	if(cepCliente == ""){
		
		erro = true;
		
		msg += "<br>O campo cep da aba cliente deve ser preenchido para gerar a impress&atilde;o.";
	
	}
	
	if(erro){
		
		msg = msg.substr(4);
		$("#msg").removeClass('sucess');
		$("#msg").addClass('erro');
		$("#msg").html(msg);
	
	}else{
	
		window.open("<?php echo URL ?>negociacoes/imprimir-promissoria?data_promissoria="+dataPromissoria+"&num_promissoria="+numPromissoria+"&valor_promissoria="+encodeURIComponent(valPromissoria)+"&nome="+encodeURIComponent(nomeCliente)+"&cpf="+encodeURIComponent(cpfCliente)+"&endereco="+encodeURIComponent(enderecoCliente)+"&cidade="+encodeURIComponent(cidadeCliente)+"&estado="+encodeURIComponent(estadoCliente)+"&cep="+encodeURIComponent(cepCliente));

	}
	
}

