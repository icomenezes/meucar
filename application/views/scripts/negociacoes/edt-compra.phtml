var timeoutFindCliente;

function findCliente(f){

	// Limpa timeout anterior
	clearTimeout(timeoutFindCliente);

	// Valida se tem pelo menos 3 caracteres
	if(f.length < 3) {
		$("#resClientes").css("display","none");
		$("#resClientes ul").html("");
		return;
	}

	// Debounce: aguarda 300ms após parar de digitar
	timeoutFindCliente = setTimeout(function(){
		$("#resClientes").css("display","block");

		var resp = $.ajax({
			url: '<?php echo URL ?>clientes/ajax/fn/getByCpfNome',
	      		async: false,
	      		type: 'POST',
	      		data: ({'f':f}),
	      		dataType: 'text'
	   	}).responseText;

		$("#resClientes ul").html(resp);
	}, 300);

}

function populaCamposCliente(f){

	var resp = $.ajax({
		url: '<?php echo URL ?>clientes/ajax/fn/getById',
      		async: false,
      		type: 'POST',
      		data: ({'f':f}),
      		dataType: 'text'
   	}).responseText;

	var arrDados = resp.split("|");
	
	var camposClientes = $("#cliente div").children().each(function(){
	
		for(x = 0; x<arrDados.length; x++){

			var arrPartes = arrDados[x].split(":");
	
			if(arrPartes[0] == $(this).attr('id')){
			
				$(this).val(arrPartes[1]);
			
			}else{
		
				if(arrPartes[0] == "id" && $(this).attr('id') == "id_cliente"){
					
					$(this).val(arrPartes[1]);
					
					$("#link_dados_cliente").attr("href","/clientes/edt/id/"+arrPartes[1]);
					
					if($("#link_dados_cliente").attr("href") != "#"){
					
						$("#link_dados_cliente").css("display","block");
					
					}
					
				}
		
			}
		
		}
	
	});

}

function findVeiculo(f){

