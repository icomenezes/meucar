function validaCampo(){

	var msg = "";
	var erro = false;

	if($("#origem").val() == ""){
		
		erro = true;
		
		msg += "<br>Na aba Cliente o campo origem deve ser preenchido.";
	
	}
	
	if($("#valor_venda").val() == ""){
		
		erro = true;
		
		msg += "<br>Na aba Ve&iacute;culo o campo valor deve ser preenchido.";
	
	}
	
	$("#pgtos_programados input").each(function (){
		
		if($(this).attr('id').substr(0,5) == "Rdata"){
	
			if($(this).val() == ""){
	
				erro = true;
			
				msg += "<br>Na aba Recebimento o campo data deve ser preenchido.";
				
			}
			
		}
	
	});

	if(erro){
		
		msg = msg.substr(4);
		$("#msg").removeClass('sucess');
		$("#msg").addClass('erro');
		$("#msg").html(msg);
		
		return false;
	
	}else{
	
		$("input[readonly='readonly']").each(function(){
		
			if($(this).attr('id') != 'data_abertura' && $(this).attr('id') != 'comissao_vendedor' && $(this).attr('id') != 'comissao_gerente' && $(this).attr('id') != 'comissao_supervisor' && $(this).attr('id') != 'data_concretizacao' && $(this).attr('id') != 'data_cancelamento'){
		
				$(this).remove();
			
			}
			
		});
		
		$("textarea[readonly='readonly']").each(function(){
		
			$(this).remove();
			
		});
		
		$("form").submit();
		
		return true;
	
	}

}



