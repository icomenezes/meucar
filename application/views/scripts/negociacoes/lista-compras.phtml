// bloco de resumo para compras: cards por vendedor (inclui sem vendedor)
if(isset($this->resumoVendedores) && count($this->resumoVendedores) > 0){

	$arrResumo = array();
	foreach($this->resumoVendedores as $r){
		$vid = (isset($r['id_vendedor']) && $r['id_vendedor']) ? $r['id_vendedor'] : '0';
		$status = $r['aprovada'];
		$valor = $r['soma'];
		$qtd = isset($r['qtd']) ? (int)$r['qtd'] : 0;
		$nome = $r['nomeUsuario'];
		if(!$nome) $nome = 'Sem vendedor';
		if(!isset($arrResumo[$vid])){
			$arrResumo[$vid] = array('nome'=>$nome, 'Aprovada'=>0, 'Pendente'=>0, 'Cancelada'=>0, 'qtdAprovada'=>0,'qtdPendente'=>0,'qtdCancelada'=>0);
		}
		if($status == 1){
			$arrResumo[$vid]['Aprovada'] += $valor;
			$arrResumo[$vid]['qtdAprovada'] += $qtd;
		}elseif($status == -1){
			$arrResumo[$vid]['Cancelada'] += $valor;
			$arrResumo[$vid]['qtdCancelada'] += $qtd;
		}else{
			$arrResumo[$vid]['Pendente'] += $valor;
			$arrResumo[$vid]['qtdPendente'] += $qtd;
		}
	}

	echo "<div style='margin-top:20px; display:flex; flex-wrap:wrap; gap:12px;'>";

	foreach($arrResumo as $vid => $dados){
		echo "<div style='border:1px solid #DDD; padding:12px; width:240px; background:#FFF; box-shadow:0 1px 2px rgba(0,0,0,0.04);'>";
		echo "<div style='font-weight:700; margin-bottom:8px;'>".htmlspecialchars($dados['nome'])."</div>";
		echo "<div style='font-size:12px; color:#2a7;'>Aprovadas: <strong>R$ ".number_format($dados['Aprovada'],2,',','.')."</strong> <span style='color:#666;'> (Qtd: ".(isset($dados['qtdAprovada'])? $dados['qtdAprovada'] : '0').")</span></div>";
		echo "<div style='font-size:12px; color:#b85;'>Pendentes: <strong>R$ ".number_format($dados['Pendente'],2,',','.')."</strong> <span style='color:#666;'> (Qtd: ".(isset($dados['qtdPendente'])? $dados['qtdPendente'] : '0').")</span></div>";
		echo "<div style='font-size:12px; color:#d33;'>Canceladas: <strong>R$ ".number_format($dados['Cancelada'],2,',','.')."</strong> <span style='color:#666;'> (Qtd: ".(isset($dados['qtdCancelada'])? $dados['qtdCancelada'] : '0').")</span></div>";
		echo "</div>";
	}

	echo "</div>";

}
?>

	<?php
	// bloco de verificação opcional: soma os registros visíveis e compara com resumoVendedores
	if(isset($_GET['verifica_resumo']) && $_GET['verifica_resumo'] == 1){

		// calcula a soma a partir das linhas já carregadas (negociacoes + negociacoesTroca)
		$calc = array();
		$processRow = function($n) use (&$calc){
			// determinar status numérico a partir do texto atual
			if($n['aprovada'] === 'Aprovada'){
				$s = 1;
			}elseif($n['aprovada'] === 'Cancelada'){
				$s = -1;
			}else{
				$s = 0;
			}
			$vid = (isset($n['id_vendedor']) && $n['id_vendedor']) ? $n['id_vendedor'] : '0';
			if(!isset($calc[$vid])) $calc[$vid] = array('Aprovada'=>0,'Pendente'=>0,'Cancelada'=>0,'nome'=> (isset($n['nomeUsuario']) && $n['nomeUsuario']) ? $n['nomeUsuario'] : 'Sem vendedor');
			if($s == 1) $calc[$vid]['Aprovada'] += $n['valor_venda'];
			elseif($s == -1) $calc[$vid]['Cancelada'] += $n['valor_venda'];
			else $calc[$vid]['Pendente'] += $n['valor_venda'];
		};

		if(isset($this->negociacoes) && is_array($this->negociacoes)){
			foreach($this->negociacoes as $n){
				// note: $n['aprovada'] was converted to text above, so it's safe to use
				$processRow($n);
			}
		}
		if(isset($this->negociacoesTroca) && is_array($this->negociacoesTroca)){
			foreach($this->negociacoesTroca as $n){
				$processRow($n);
			}
		}

		// transformar resumoVendedores em formato id=>dados para fácil comparação
		$dbResumo = array();
		if(isset($this->resumoVendedores) && is_array($this->resumoVendedores)){
			foreach($this->resumoVendedores as $r){
				$vid = (isset($r['id_vendedor']) && $r['id_vendedor']) ? $r['id_vendedor'] : '0';
				if(!isset($dbResumo[$vid])) $dbResumo[$vid] = array('Aprovada'=>0,'Pendente'=>0,'Cancelada'=>0,'nome'=>($r['nomeUsuario'] ? $r['nomeUsuario'] : 'Sem vendedor'));
				if($r['aprovada'] == 1) $dbResumo[$vid]['Aprovada'] += $r['soma'];
				elseif($r['aprovada'] == -1) $dbResumo[$vid]['Cancelada'] += $r['soma'];
				else $dbResumo[$vid]['Pendente'] += $r['soma'];
			}
		}

		echo "<div style='margin-top:20px;padding:12px;border:1px dashed #CCC;background:#FFF;'>";
		echo "<h3>Verificação de resumo (visível na tela)</h3>";
		echo "<table style='width:100%;border-collapse:collapse;'><tr><th style='text-align:left'>Vendedor</th><th>Campo</th><th>Grid</th><th>DB resumo</th><th>Diferença</th></tr>";

		$allVids = array_unique(array_merge(array_keys($calc), array_keys($dbResumo)));
		foreach($allVids as $vid){
			$g = isset($calc[$vid]) ? $calc[$vid] : array('Aprovada'=>0,'Pendente'=>0,'Cancelada'=>0,'nome'=>($dbResumo[$vid]['nome'] ?? 'Sem vendedor'));
			$d = isset($dbResumo[$vid]) ? $dbResumo[$vid] : array('Aprovada'=>0,'Pendente'=>0,'Cancelada'=>0,'nome'=>($g['nome'] ?? 'Sem vendedor'));
			foreach(array('Aprovada','Pendente','Cancelada') as $c){
				$diff = $g[$c] - $d[$c];
				echo "<tr><td>".htmlspecialchars($g['nome'])."</td><td>$c</td><td style='text-align:right'>R$ ".number_format($g[$c],2,',','.')."</td><td style='text-align:right'>R$ ".number_format($d[$c],2,',','.')."</td><td style='text-align:right'>R$ ".number_format($diff,2,',','.')."</td></tr>";
			}
		}

		echo "</table></div>";

	}
	?>

<script type="text/javascript">

	function confirmaDelete(msg, id){
	
		if(confirm("Deseja realmente excluir a "+msg+" ?")){
		
			window.location.href = "del-compra/id/" + id;
		
		}
	
	}
	
	$("#data_inicial").mask("99/99/9999");
	$('#data_inicial').focus(function(){
		$(this).calendario({
			target:'#data_inicial'
		});
	});
	
	$("#data_final").mask("99/99/9999");
	$('#data_final').focus(function(){
		$(this).calendario({
			target:'#data_final'
		});
	});
	
	
	function enviaPeriodo(valor){
		
		if(valor != "0"){
		
			var arrData = valor.split("_");
			var datafinal = arrData[0]+"/"+arrData[1]+"/"+arrData[2];
			var dataInicial = "01/"+arrData[1]+"/"+arrData[2];
			
			$("#data_inicial").val(dataInicial);
			$("#data_final").val(datafinal);
		
		}
	
	}

</script>
