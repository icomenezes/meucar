<?php
// bloco de resumo: cards por vendedor com soma por status (aprovada)
if(isset($this->resumoVendedores) && count($this->resumoVendedores) > 0){

	// reorganiza em array por vendedor
	$arrResumo = array();
	foreach($this->resumoVendedores as $r){
		$vid = (isset($r['id_vendedor']) && $r['id_vendedor']) ? $r['id_vendedor'] : '0';
		$status = $r['aprovada'];
		$valor = $r['soma'];
		$qtd = isset($r['qtd']) ? (int)$r['qtd'] : 0;
		$nome = $r['nomeUsuario'];
		if(!$nome) $nome = 'Sem vendedor';
		if(!isset($arrResumo[$vid])){
			$arrResumo[$vid] = array('nome'=>$nome, 'Aprovada'=>0, 'Pendente'=>0, 'Cancelada'=>0, 'qtdAprovada'=>0,'qtdPendente'=>0,'qtdCancelada'=>0);
		}
		if($status == 1){
			$arrResumo[$vid]['Aprovada'] += $valor;
			$arrResumo[$vid]['qtdAprovada'] += $qtd;
		}elseif($status == -1){
			$arrResumo[$vid]['Cancelada'] += $valor;
			$arrResumo[$vid]['qtdCancelada'] += $qtd;
		}else{
			$arrResumo[$vid]['Pendente'] += $valor;
			$arrResumo[$vid]['qtdPendente'] += $qtd;
		}
	}

	echo "<div style='margin-top:20px; display:flex; flex-wrap:wrap; gap:12px;'>";

	foreach($arrResumo as $vid => $dados){
		echo "<div style='border:1px solid #DDD; padding:12px; width:240px; background:#FFF; box-shadow:0 1px 2px rgba(0,0,0,0.04);'>";
		echo "<div style='font-weight:700; margin-bottom:8px;'>".htmlspecialchars($dados['nome'])."</div>";
		echo "<div style='font-size:12px; color:#2a7;'>Aprovadas: <strong>R$ ".number_format($dados['Aprovada'],2,',','.')."</strong> <span style='color:#666;'> (Qtd: ".(isset($dados['qtdAprovada'])? $dados['qtdAprovada'] : '0').")</span></div>";
		echo "<div style='font-size:12px; color:#b85;'>Pendentes: <strong>R$ ".number_format($dados['Pendente'],2,',','.')."</strong> <span style='color:#666;'> (Qtd: ".(isset($dados['qtdPendente'])? $dados['qtdPendente'] : '0').")</span></div>";
		echo "<div style='font-size:12px; color:#d33;'>Canceladas: <strong>R$ ".number_format($dados['Cancelada'],2,',','.')."</strong> <span style='color:#666;'> (Qtd: ".(isset($dados['qtdCancelada'])? $dados['qtdCancelada'] : '0').")</span></div>";
		echo "</div>";
	}

	echo "</div>";

}
