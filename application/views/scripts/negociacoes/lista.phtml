<script type="text/javascript">

	function validaForm(){

		var erro = false;
		var msg = "";

		if($("#nome").val() != ""){
			if($("#nome").val().length < 3){
				erro = true;
				msg += "Informe um nome com mais de duas letras\n";
			}
		}

		if($("#placa").val() != ""){
			if($("#placa").val().length < 3){
				erro = true;
				msg += "Informe uma placa com mais de dois caracteres\n";
			}
		}

		if($("#str_modelo").val() != ""){
			if($("#str_modelo").val().length < 3){
				erro = true;
				msg += "Informe um modelo com mais de dois caracteres\n";
			}
		}

		if(erro == false){
			$("#form_pesquisa").submit();
		}else{
			alert(msg);
		}

	}

	function confirmaDelete(msg, id){
	
		if(confirm("Deseja realmente excluir a "+msg+" ?")){
		
			window.location.href = "del/id/" + id;
		
		}
	
	}
	
	$("#data_inicial").mask("99/99/9999");
	$('#data_inicial').focus(function(){
		$(this).calendario({
			target:'#data_inicial'
		});
	});
	
	$("#data_final").mask("99/99/9999");
	$('#data_final').focus(function(){
		$(this).calendario({
			target:'#data_final'
		});
	});
	
	
	function enviaPeriodo(valor){
		
		if(valor != "0"){
		
			var arrData = valor.split("_");
			var datafinal = arrData[0]+"/"+arrData[1]+"/"+arrData[2];
			var dataInicial = "01/"+arrData[1]+"/"+arrData[2];
			
			$("#data_inicial").val(dataInicial);
			$("#data_final").val(datafinal);
		
		}else{
			$("#data_inicial").val("");
			$("#data_final").val("");
		}
	
	}

</script>
