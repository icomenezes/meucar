function esconde(f){
	
	$(f).css("display","none");
	
}

var timeoutFindCliente;

function findCliente(f){

	// Limpa timeout anterior
	clearTimeout(timeoutFindCliente);

	// Valida se tem pelo menos 3 caracteres
	if(f.length < 3) {
		$("#resClientes").css("display","none");
		$("#resClientes ul").html("");
		return;
	}

	// Debounce: aguarda 300ms após parar de digitar
	timeoutFindCliente = setTimeout(function(){
		$("#resClientes").css("display","block");

		var resp = $.ajax({
			url: '<?php echo URL ?>clientes/ajax/fn/getByCpfNome',
	      		async: false,
	      		type: 'POST',
	      		data: ({'f':f}),
	      		dataType: 'text'
	   	}).responseText;

		$("#resClientes ul").html(resp);
	}, 300);

}

function populaCamposCliente(f){

	var resp = $.ajax({
		url: '<?php echo URL ?>clientes/ajax/fn/getById',
      		async: false,
      		type: 'POST',
      		data: ({'f':f}),
      		dataType: 'text'
   	}).responseText;

	var arrDados = resp.split("|");
	
	var camposClientes = $("#cliente div").children().each(function(){
	
		for(x = 0; x<arrDados.length; x++){

			var arrPartes = arrDados[x].split(":");
	
			if(arrPartes[0] == $(this).attr('id')){
			
				$(this).val(arrPartes[1]);
			
			}else{
		
				if(arrPartes[0] == "id" && $(this).attr('id') == "id_cliente"){
					
					$(this).val(arrPartes[1]);
					
				}
		
			}
		
		}
	
	});

}

function findVeiculo(f){

	$("#resVeiculos").css("display","block");

	var resp = $.ajax({
		url: '<?php echo URL ?>veiculos/ajax/fn/getByPlacaModelo/vendido/no/fn_compra/true',
      		async: false,
      		type: 'POST',
      		data: ({'f':f}),
      		dataType: 'text'
   	}).responseText;

	$("#resVeiculos ul").html(resp);

}

function populaCamposVeiculo(f){

	var resp = $.ajax({
		url: '<?php echo URL ?>veiculos/ajax/fn/getById',
      		async: false,
      		type: 'POST',
      		data: ({'f':f}),
      		dataType: 'text'
   	}).responseText;

	var arrDados = resp.split("|");
	
	var camposVeiculos = $("#venda div").children().each(function(){
	
		for(x = 0; x<arrDados.length; x++){

			var arrPartes = arrDados[x].split(":");
	
			if(arrPartes[0] == $(this).attr('id')){
			
				$(this).val(arrPartes[1]);
				
				if(arrPartes[0] == 'valor_venda'){
				
					arrPartes[1] = arrPartes[1].replace(".",",");
					
					$(this).val(arrPartes[1]);
					$("#valor_base_calculo").val(arrPartes[1]);
				
				}
				
			}else{
		
				if(arrPartes[0] == "id" && $(this).attr('id') == "id_veiculo"){
					
					$(this).val(arrPartes[1]);
					
				}
	
			}
		
		
		}
	
	});
		
	dataAquisicao = $("#data_aquisicao").val().split("-");
	$("#data_compra").val(dataAquisicao[2]+"/"+dataAquisicao[1]+"/"+dataAquisicao[0]);
	
	atualizaCamposVenda();

}


