function atualizaCamposVenda(){

	valo = $("#valor_venda").val();
	
	valo = valo.replace(".","");
	valo = valo.replace(",",".");

	$("#recebimento input[id='valor_venda']").val(valo);
	
}

function validaCampo(){

	var msg = "";
	var erro = false;

	if($("#id_cliente").val() == ""){

		erro = true;

		msg += "<br>Na aba Cliente nenhum cliente foi selecionado.";

	}

	if($("#origem").val() == ""){

		erro = true;

		msg += "<br>Na aba Cliente o campo origem deve ser preenchido.";

	}
	
	if($("#valor_venda").val() == ""){
		
		erro = true;
		
		msg += "<br>Na aba Ve&iacute;culo o campo valor deve ser preenchido.";
	
	}
	
	
	
	$("#pgtos_programados input").each(function (){
		
		if($(this).attr('id').substr(0,5) == "Rdata"){
	
			if($(this).val() == ""){
	
				erro = true;
			
				msg += "<br>Na aba Pagamentos o campo data deve ser preenchido.";
				
			}
			
		}
	
	});
	
	if(erro){
		
		msg = msg.substr(4);
		$("#msg").removeClass('sucess');
		$("#msg").addClass('erro');
		$("#msg").html(msg);
		
		return false;
	
	}else{
		
		$("form").submit();
		
		$("#bnt_cadastrar").remove();
		
		return true;
	
	}

}

