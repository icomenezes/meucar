	var line = $("#pgto_line_0").clone();
	
	$("#pgtos_programados").append(line);
	
	$("#pgtos_programados tr:last td").each(function(){

		var idLine = $(this).children().attr('id').split("_");
		$(this).children().attr('id', idLine[0]+"_"+pgtosAdd);
		$(this).children().attr('name', idLine[0]+"_"+pgtosAdd);
		
		if($(this).children().attr('id') == "deleta_"+pgtosAdd){
		
