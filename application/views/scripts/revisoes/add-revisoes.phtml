			data:{idempresa:id},                       
			success:function(retorno){
				
				$("#id_fornecedor").html(retorno);
			
			}
		})

}
	
	
	buscaFornecedores(<?php echo $_SESSION['sessionUser']['id_empresa'];?>);
	
</script>