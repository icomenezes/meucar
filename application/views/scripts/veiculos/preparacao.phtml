<script type="text/javascript">

	var status;
	var dataEntrada;
	var dataConcluido;
	var diasExtras;
	var idGlobal;
	var servicoGlobal;

	function closePopup(){
		$(".obs_date").css("display", "none");
		if(idGlobal){
			$("#"+servicoGlobal+"_"+idGlobal).val(status);
			$("#"+servicoGlobal+"_data_entrada_"+idGlobal).val(dataEntrada);
			$("#"+servicoGlobal+"_data_concluido_"+idGlobal).val(dataConcluido);
			$("#"+servicoGlobal+"_dias_extras_"+idGlobal).val(diasExtras);
		}

		salvarPreparacaoTodos(servicoGlobal, idGlobal, false);
	}


	function openPopup(este, servico, id){
		closePopup();
		idGlobal = id;
		servicoGlobal = servico;
		status = $("#"+servicoGlobal+"_"+idGlobal).val();
		dataEntrada = $("#"+servicoGlobal+"_data_entrada_"+idGlobal).val();
		dataConcluido = $("#"+servicoGlobal+"_data_concluido_"+idGlobal).val();
		diasExtras = $("#"+servicoGlobal+"_dias_extras_"+idGlobal).val();

		$(este).parent().next().css("display", "block");
		$(este).parent().next().css("position", "absolute");
