	function verificaData(){

		$("input").each(function(){

			if($(this).attr("id")){

				arrTemp = $(this).attr("id").split("_");

				if(arrTemp[1]+"_"+arrTemp[2] == "data_concluido"){

					var dia = $(this).val().split("/")[0];
					var mes = $(this).val().split("/")[1];
					var ano = $(this).val().split("/")[2];
					var times = new Date(ano, mes, dia).getTime();

					var diaHoje = new Date().getDate();
					var mesHoje = (new Date().getMonth()+1);
					var anoHoje = new Date().getFullYear();
					if(diaHoje < 10){
						diaHoje = "0"+diaHoje;
					}
					if(mesHoje < 10){
						mesHoje = "0"+mesHoje;
					}
					var timesHoje = new Date(anoHoje, mesHoje, diaHoje).getTime();

					arrTempId = $(this).attr("id").split("_");

					if($("#"+arrTempId[0]+"_"+arrTempId[3]).val() != 2 && $("#"+arrTempId[0]+"_"+arrTempId[3]).val() != 1){

						if(timesHoje > times){

							$(this).addClass("vencida");

							$("#data_final_"+arrTempId[0]+"_"+arrTempId[3]).addClass("vencida");

						}else{

							$(this).removeClass("vencida");

							$("#data_final_"+arrTempId[0]+"_"+arrTempId[3]).removeClass("vencida");

						}

					}else{
						if($("#"+arrTempId[0]+"_"+arrTempId[3]).val() != 1){
							$("#data_final_"+arrTempId[0]+"_"+arrTempId[3]).html("Sem reparos");
						}
					}

				}

			}

		});

	}

	function retornaDataFinal(dataInicio, diasPreparacao, diasExtras){

		var timestamp = new Date(dataInicio.split("/")[2], parseInt(dataInicio.split("/")[1]), parseInt(dataInicio.split("/")[0])+parseInt(diasPreparacao)+parseInt(diasExtras));
		var mes = timestamp.getMonth();
		var dia = timestamp.getDate();

		if(dia < 10){
			dia = "0"+dia;
		}
		if(mes < 10){
			mes = "0"+mes;
		}

		var retorno = dia+"/"+mes+"/"+timestamp.getFullYear();

		if(retorno == "NaN/NaN/NaN"){
			return "";
		}else{
			return retorno;
		}


	}

