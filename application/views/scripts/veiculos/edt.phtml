			type: "POST",
			url:"/veiculos/ajax/fn/deleta_despesa/id_despesa/"+id,
			dataType:"html",                       
			success:function(retorno){

				if(retorno == "Sucesso"){

					$("#Ddata_"+id).parent().parent().remove();
					calculaValordespesas();
					
					$("#despesas_negociacao tr td input").each(function(){
	
						if($(this).attr('id').substring(0,5) == "Ddata"){
							
							temElemento = false;
						
						}
					
					})
					
					if(temElemento){
					
						$("#despesas_negociacao").html("<tr id='despesas_negociacao_line_0'><td></td><td></td><td></td><td></td><td></td><td></td><td><input type='button' id='btn_0' name='btn_0' class='btn-mini btn-include' value='Add' onclick='adicionarRevioes();'></td></tr>");
					
					}
					
				}else{
				
					alert(retorno);
				
