    document.getElementById('foto_multiple').addEventListener('change', async function (event) {
    const files = event.target.files;
    const dataTransfer = new DataTransfer();
    const jpegInput = document.getElementById('foto_multiple');

    $('#images').html('<h2 style="padding: 5px; background-color: red; color: white;">Aguarde...</h2>');

    for (const file of files) {
        // ✅ CORREÇÃO 1: Verificação correta da extensão
        const extensao = file.name.split(".").pop().toLowerCase();

        if (extensao === "heic" || extensao === "heif") { // Suporta ambos formatos Apple
            try {
                // Converte o arquivo HEIC para JPEG
                const convertedBlob = await heic2any({
                    blob: file,
                    toType: 'image/jpeg',
                    quality: 0.9, // ✅ Ajustei para 0.9 (melhor performance)
                });

                // ✅ CORREÇÃO 2: Trata retorno como array ou blob único
                const blobToConvert = Array.isArray(convertedBlob) 
                    ? convertedBlob[0] 
                    : convertedBlob;

                // Cria um novo arquivo com nome correto
                const novoNome = file.name.replace(/\.heic$/i, '.jpeg').replace(/\.heif$/i, '.jpeg');
                const convertedFile = new File([blobToConvert], novoNome, {
                    type: 'image/jpeg',
                    lastModified: new Date().getTime()
                });

                dataTransfer.items.add(convertedFile);

                console.log(`✅ Convertido: ${file.name} → ${novoNome}`);

            } catch (error) {
                console.error('❌ Erro ao converter HEIC:', error);
                console.error('Arquivo problema:', file.name);
                alert(`Não foi possível converter o arquivo: ${file.name}\nErro: ${error.message}`);
                
                // ✅ Opcional: adiciona o arquivo original mesmo com erro
                // dataTransfer.items.add(file);
            }

        } else {
            // Arquivos não-HEIC são adicionados diretamente
            dataTransfer.items.add(file);
        }
    }

    // Atualiza o input com os arquivos processados
    jpegInput.files = dataTransfer.files;
    
    // ✅ IMPORTANTE: Só chama preview se houver arquivos
    if (dataTransfer.files.length > 0) {
        preview(jpegInput);
    } else {
        $('#images').html('<p style="color: red;">Nenhum arquivo válido foi carregado.</p>');
    }
});

	function previewUnico(input, i){
	
		name = $(input).val();
	
		var reader = new FileReader();

		reader.onload = function (e){

			$("#td_input_"+i).attr("colspan","1");
			$("#coluna_foto_"+i).remove();
			$("#coluna_radio_"+i).remove();
			$("#td_input_"+i).before("<td id='coluna_foto_"+i+"' style='width:86px; height:60px;'><img id='fot_"+i+"' style='width:86px; height:60px;' src='"+e.target.result+"' /></td><td id='coluna_radio_"+i+"' ><input type='radio' id='capa' name='capa' value='"+name+"' onclick='mudaFoto("+i+");'></td>");
		
		};
        
		reader.readAsDataURL(input.files[0]);
		
		if(input.files[0].size > 200000){
	
			msgFoto = true;
			
		}

	}
	
	
	width = $(window).width();
	height = $(window).height();
	porcento = 8;

	function preview(input){
	
		msgFoto = false;
	
		$('#images').html(" ");
	
		for (i = 0; i < input.files.length; i++){
		
			var reader = new FileReader();

			reader.onload = function (e){
				
				$('#images').html($('#images').html() + "<td style='padding:2px; vertical-align:middle;'><div id='div_borda' style='border:solid 2px; width:"+(width*porcento)/100+"px; height:"+(height*porcento)/100+"px;'><img src='"+e.target.result+"' style='width:"+(width*porcento)/100+"px; height:"+(height*porcento)/100+"px;' /></div><center><input type=radio name='capa_multiplo' id='capa_0' value='foto_0' onclick='borda(this);' /></center></td>");
				
			};
        
			reader.readAsDataURL(input.files[i]);
			
			if(input.files[i].size > 200000){
				
				msgFoto = true;
			
			}
			
			if(i == 8){
				
				break;
			
			}
    
		}
		
		setTimeout('nomeiaFotos()',3000);
	
	}
	
	
	function nomeiaFotos(){
		
		var cont = 1;
		
		$("#images > td > center > input ").each(function(){

			$(this).attr("id", "capa_"+cont);
			$(this).attr("value", cont);
			
			cont++;
			
		});
	
		$("#capa_1").click();
		
		$("#texto_capa").css("display","block");
		
	}
	
	function borda(este){
	
		$("#images > td > div ").each(function(){

			$(this).css("border-color", "#666666");
			
			
		});
		
		$(este).parent().parent().children().css("border-color", "red");
	
	}

