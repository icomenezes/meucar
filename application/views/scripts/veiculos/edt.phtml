					"<td style='width:10%;'><input type='text' id='Pdata_0' name='Pdata_0' class='text' value=\"\"/></td>"+
					"<td><input type='text' id='Pdescricao_0' name='Pdescricao_0' class='text' value=\"\" /></td>"+
					"<td style='width:20%;'><input type='button' class='btn-small btn-del' id='deleta' value='Deletar' onclick='confirmaDeletePendencia(0);'/><input type='button' id='btn_0' name='btn_0' class='btn-mini btn-include' value='Add' onclick='addPendencia()'></td>"+
				"</tr>";
				
	$("#pendencia").html(pendencia);
	
	$("#Pdata_0").mask("99/99/9999");
	$("#Pdata_0").focus(function(){
		$(this).calendario({
			target:"#Pdata_0"
		});
	});
}


