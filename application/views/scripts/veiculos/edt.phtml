function buscaFornecedores(id, idSelect, valor){

	$.ajax({                   

		type: "POST",

        url:"/fornecedores/ajax",

        dataType:"html",

        data:{idempresa:id},                       

        success:function(retorno){

			$("#"+idSelect).html(retorno);
			
			//alert(idSelect);
		
		}

	})

}

