var input = 10;

function confirmaDelete(id){

	decisao = confirm("Deseja realmente deletar?");
	
	if (decisao){
	
		$.ajax({
			type: "POST",
			url:"/veiculos/ajax/fn/deleta_foto/id_foto/"+id,
			dataType:"html",                       
			success:function(retorno){

				if(retorno == "Sucesso"){

					$("#coluna_foto_"+id).remove();
					$("#coluna_radio_"+id).remove();
					
					if($("#coluna_button_"+id).parent().children().children().attr('id') == "foto_capa"){
					
						$("#foto_capa").parent().parent().append("<td id='td_input_"+input+"' colspan='3' ><input type='file' id='foto' name='foto[]' title='Fotos' onchange='converte(this, "+input+")' /></td>");
					
					}else{
					
						$("#coluna_button_"+id).parent().html("<td id='td_input_"+input+"' colspan='3' ><input type='file' id='foto' name='foto[]' title='Fotos' onchange='converte(this, "+input+")' /></td>");
					
					}
					
					input++;
					
					$("#coluna_button_"+id).remove();
				
				}else{
				
					alert(retorno);
				
				}
		
			}
		})
		
	}
	
