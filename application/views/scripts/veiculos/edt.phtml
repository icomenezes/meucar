	var line = $("#anexo_line_0").clone();
	
	$("#table_anexo").append(line);
	
	$("#table_anexo tr:last td").each(function(){

		var idLine = $(this).children().attr('id').split("_");
		$(this).children().attr('id', idLine[0]+"_"+anexoAdd);
		$(this).children().attr('name', idLine[0]+"_"+anexoAdd);
		
