function getIdModelo(retorno) {

	let tipo = $('#tipo option:selected').text().toLocaleLowerCase();
	let marca = $('#id_marca option:selected').text();
	let modelo = $('#id_modelos option:selected').text();
	let id_ano_modelo = $('#id_ano_modelo').val();

	$.ajax({
		type: "POST",
        url:"/modelos/ajax",
        dataType:"json",
        data:{
			ano_modelo_fipe: retorno.ano_modelo,
			codigo_fipe: retorno.codigo_fipe,
			combustivel: retorno.combustivel,
			valor: retorno.valor,
			tipo: tipo,
			marca_fipe: marca,
			modelo_fipe: modelo,
			id_ano_modelo: id_ano_modelo,
			fn:"get_modelo"
		},
        success:function(id){
			$("#id_modelo").val(id);
        }
	});
}


