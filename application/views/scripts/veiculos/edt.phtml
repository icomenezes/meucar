function buscaAno(string){

	$("#id_ano_modelo").prop("disabled", true);

	segmento = $("#tipo").val();
	id_marca = $("#id_marca").val();

	$.ajax({
		type: "POST",
		async: true,
        url:"/modelos/ajax",
        dataType:"html",
        data:{modelo_id:string, marca_id:id_marca, tipo:segmento, fn:"fipe_anos"},
        success:function(retorno){
			$("#id_ano_modelo").html(retorno);
			$("#id_ano_modelo").prop("disabled", false);
		}
	})

