		$("#fisica").css("display","block");
	
	}
	
	if(exibe == "juridica"){

		$("#pessoas").css("display","block");
		$("#fisica").css("display","none");
		$("#juridica").css("display","block");
	
	}
	
	if(exibe == "gnv_sim"){
		
		$("#doc").css("display","block");

	}
	
	if(exibe == "gnv_nao"){
		
		$("#doc").css("display","none");
	
	}
	
	if(exibe == "leasing_list_sim"){
		
		$("#leasing_list").css("display","block");
	
	}
	
	if(exibe == "leasing_list_nao"){
		
		$("#leasing_list").css("display","none");
	
	}
	
}

var arrTotal = new Array();

function calculaValordespesas(){

	var total = 0;
	
	$("#despesas_negociacao tr td input").each(function(){
	
		if($(this).attr('id').substring(0,6) == 'Dvalor'){
		
			total += moeda2float($(this).val())
		
		}
	
	});
	
	$("#total").html(float2moeda(total));
	
