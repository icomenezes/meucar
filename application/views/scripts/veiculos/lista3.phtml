							$("#fechar_modal").click();
							$("#ex1").html('<center><a id="fechar_modal" href="#" rel="modal:close"></a><img src="../images/disket.gif"/><br/><span style="font-size:17px;">Salvando altera&ccedil;&otilde;es! Aguarde...</span></center>');
						}, 3000);
						window.location.href="/veiculos/lista3";
					}else{
					
						$("#ex1").html('<center><a id="fechar_modal" href="#" rel="modal:close"></a><span style="font-size:17px; color:red;">Houve um erro inesperado!<br/>Por favor verifique suas altera&ccedil;&otilde;es e tente novamente!</span></center>');
					
					}
				
				}
				
			});

		}
		
	}

