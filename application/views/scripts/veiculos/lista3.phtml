	function validaCampos(){
	
		var retorno = "";
		var strJson = "";
		var strJsonSelect = "";
		var strJsonCheckbox = "";
		var erro = false;
		var cont = 0;
		
		
	
		$(":text").each(function(){
		
			id = $(this).attr("id");
			arrValor = id.split("_");
		
			if(arrValor[0] == "valor"){
				
				if($(this).val() == ""){
				
					erro = true;
					cont++;
				
				}
			
			}
		
		});
		
		if(erro){
		
			if(cont == 1){
				
				alert("Há um campo com valor não preenchido!");
			
			}else{
		
				alert("Há campos com os valores não preenchidos!");
				
			}
		
		}else{
		
			$("#abrir_modal").click();
	
			$(":text").each(function(){
		
				id = $(this).attr("id");
				arrValor = id.split("_");
			
				if(arrValor[0] == "valor"){
					
					strJson += '"'+$(this).attr("id")+'":'+$(this).val().replace(',','.')+', ';

				}
		
			});
			
			
			strJson = strJson.substring(0,strJson.length-2);
			strJson = "{"+strJson+"}";
			
			$(":checkbox").each(function(){
		
				if($(this).is(":checked")){
		
					id = $(this).attr("id");
					arrValor = id.split("_");
				
					if(arrValor[0] == "icarros"){
						
						strJsonCheckbox += '"'+$(this).attr("id")+'":'+$(this).val().replace(',','.')+', ';

					}
				
				}
		
			});
			
			
			
			strJsonCheckbox = strJsonCheckbox.substring(0,strJsonCheckbox.length-2);
			strJsonCheckbox = "{"+strJsonCheckbox+"}";
			
			if(total != 0){
			
				$("select").each(function(){
			
					//alert($(this).val());
			
					if($(this).val() != ""){
			
						id = $(this).attr("id");
						arrValor = id.split("_");
					
						if(arrValor[0] == "tipoanuncio"){
							
							strJsonSelect += '"'+$(this).attr("id")+'":'+$(this).val().replace(',','.')+', ';

						}
					
					}
			
				});
				
				strJsonSelect = strJsonSelect.substring(0,strJsonSelect.length-2);
				strJsonSelect = "{"+strJsonSelect+"}";
		
			}
			
			$.ajax({                   
				type: "POST",
				url:"/veiculos/ajax/fn/edita_valores_icarros",
				dataType:"html",
				data:{json_valores:strJson, json_checkbox:strJsonCheckbox, json_select:strJsonSelect},                       
				success:function(retorno){
				
					//alert(retorno);
					
					$("#teste").html(retorno);
				
					if(retorno == "sucesso"){
					
						$("#ex1").html('<center><a id="fechar_modal" href="#" rel="modal:close"></a><span style="font-size:17px;">Altera&ccedil;&otilde;es efetuadas com sucesso!</span></center>');
					
