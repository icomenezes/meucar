<script type="text/javascript">

var arrTipoAnuncio = new Array();
var arrQtdAtivos = new Array();
var arrIdAnuncios = new Array();
var arrNomeAnuncios = new Array();
var arrTotalAnuncios = new Array();
var arrTotalAnunciosTemp = new Array();
var idTipoAntigo = 0;
var idNovo = "";
var total = 0;
var totalUsados = 0;

function buscaQtdPlanos(){
  
	$.ajax({                   
		type: "POST",
        url:"/icarros/ajax/fn/get_qtd_anuncios_icarros",
        dataType:"html",
        //data:{fipe:string},                       
        success:function(retorno){
		
			//alert(retorno);
			
			arrTipoAnuncio = retorno.split(",");

			var i = 0;

			while(i < 12){
			
				if(!arrTipoAnuncio[i+3]){
					
					i = 12;
				
				}else{
			
					total += parseInt(arrTipoAnuncio[i+3]);
					totalUsados += parseInt(arrTipoAnuncio[i+2]);
					arrQtdAtivos[arrTipoAnuncio[i]] = parseInt(arrTipoAnuncio[i+3] - arrTipoAnuncio[i+2]);
					arrIdAnuncios[arrTipoAnuncio[i]] = arrTipoAnuncio[i];
					arrNomeAnuncios[arrTipoAnuncio[i]] = arrTipoAnuncio[i+1];
					arrTotalAnuncios[arrTipoAnuncio[i]] = parseInt(arrTipoAnuncio[i+3]);
					
					//alert(arrQtdAtivos[13]);
		
					i=i+4;
					
				}
	
			}
			
			if(retorno == "erro"){
			
				totalUsados = 0;
				total = 0;
			
			}

			
			$("#total_anuncios").html(totalUsados+"/"+total);
			
			$("select").each(function(){
		
				$ide = $(this).attr('id').split("_");
		
				if($ide[0] == "tipoanuncio"){
				
					$("#sincro_image").remove();
				
					$(this).parent().parent().children().css("display","block");

				}
				
			});

        }
		
	})

}

function addIcarros(id){
	
	var ide = id.split("_");
	
	if($("#"+id).is(":checked")){
	
		if(totalUsados >= total){
		
			$("#tipoanuncio_"+ide[1]).attr("disabled", true);
			$("#"+id).attr("checked", false);
			alert("Não há mais espaço para o plano contratado no Icarros");
		
		}else{

			$("#abrir_modal_aguarde").click();
		
			$.ajax({                   
				type: "POST",
				url:"/icarros/ajax/fn/get_modelos_fipe",
				//async: false,
				dataType:"html",
				data:{id_veiculo:ide[1]},                       
				success:function(retorno){
		
					if(retorno != ""){
						
						$("#"+id).attr('checked', false);
						$("#modelos_veiculos").html(retorno);
						$("#buttomPronto").attr("onClick","mudaModelo('"+id+"', true)");
						$("#abrir_modal_versoes").click();
					
					}
			
				}
			});
			
		}
	
	}else{

		$("#tipoanuncio_"+ide[1]).attr("disabled", true);
		$("#tipoanuncio_"+ide[1]).html("<option value=''>Selecione</option>");
		
		mudaModelo(id,false);

	}

}

	function mudaModelo(id, status){
	
		var optionLivre = "";
		var option = "";
		var primeiro = true;
		var ide = id.split("_");
	
		totalUsados = total;
	
		for(x in arrTotalAnuncios){
	
			arrTotalAnunciosTemp[x] = arrTotalAnuncios[x];
	
		}
	
		if(status){
	
			$("#"+id).attr('checked', true);
			
		}
	
		arrId = id.split("_");
	
		valor = $("#modelos_veiculos").val();
	
		$("#"+id).val(valor);
		
		$("#fechar_modal_versoes").click();
		
		
		$("select").each(function(){
		
			$ide = $(this).attr('id').split("_");
		
			if($ide[0] == "tipoanuncio"){
		
				if($(this).val() != ""){
		
					arrTotalAnunciosTemp[$(this).val()] -= 1;
			
				}
		
			}
	
		});
	
		for(x in arrTotalAnunciosTemp){
	
			if(arrTotalAnunciosTemp[x] > 0){
			
				if(primeiro){
				
					option = "<option selected='selected' value='"+arrIdAnuncios[x]+"'>"+arrNomeAnuncios[x]+"</option>";
					
					if($("#"+id).is(":checked")){
					
						$("#tipoanuncio_"+ide[1]).attr("disabled", false);
						$("#tipoanuncio_"+ide[1]).html(option);
					
					}else{
						
						optionLivre = "<option value='"+arrIdAnuncios[x]+"'>"+arrNomeAnuncios[x]+"</option>";
						
					}
					
					primeiro = false;
				
				}else{
		
					optionLivre += "<option value='"+arrIdAnuncios[x]+"'>"+arrNomeAnuncios[x]+"</option>";
			
				}
			
			}
	
		}

	if(optionLivre == "" && option == ""){
		
		$("#tipoanuncio_"+ide[1]).attr("disabled", true);
		$("#"+id).attr("checked", false);
		alert("Não há mais espaço para o plano contratado no Icarros");
		
	
	}else{
	
		$("select").each(function(){
		
			$ide = $(this).attr('id').split("_");
		
			if($ide[0] == "tipoanuncio"){
		
				if($(this).val() != ""){
		
					optionSelected = "<option selected='selected' value='"+arrIdAnuncios[$(this).val()]+"'>"+arrNomeAnuncios[$(this).val()]+"</option>";
					
					$(this).html(optionLivre + optionSelected);
					
					totalUsados -= 1;
					
				}
		
			}
	
		});
		
		$("#total_anuncios").html((total-totalUsados)+"/"+total);
	
	}
	
	mostraBotao();

	
	}
	
	
buscaQtdPlanos();

function tipoAnuncioAntigo(value){

	idTipoAntigo = parseInt(value);

}

function retornaTipoAnuncio(id, value){

	mostraBotao();

	novo = arrQtdAtivos[value];
	velho = arrQtdAtivos[idTipoAntigo];

	arrQtdAtivos[value] = novo-1;
	arrQtdAtivos[idTipoAntigo] = velho+1;
	
	//alert(arrIdAnuncios[value]+"=>"+arrQtdAtivos[value]+" ||||||||||||||| "+arrIdAnuncios[idTipoAntigo]+"=>"+arrQtdAtivos[idTipoAntigo]);

	$("select").each(function(){
		
		$ide = $(this).attr('id').split("_");
		
		if($ide[0] == "tipoanuncio"  && $(this).val() != ""){
		
			strOption = "<option selected='selected' value='"+arrIdAnuncios[$(this).val()]+"'>"+arrNomeAnuncios[$(this).val()]+"</option>";
			
			for(x in arrIdAnuncios){
				
				if(arrQtdAtivos[x] > 0){
				
					if($(this).val() != x){
				
						strOption += "<option value='"+arrIdAnuncios[x]+"'>"+arrNomeAnuncios[x]+"</option>";
				
					}
				
				}
			
			}
			
			$(this).html(strOption);
			
		}
		
	});
	
}

