        success:function(retorno){

			$("#id_ano_modelo").html(retorno);
			$("#id_ano_modelo").prop("disabled", false);
			var fonteA = $("#id_ano_modelo option:first").data("fonte");
			if(fonteA == "parallelum") showToastFipe("⚠️ FIPE indisponível. Usando API alternativa (Parallelum).");
			if(fonteA == "local")      showToastFipe("⚠️ APIs externas indisponíveis. Usando base de dados local.");
		}

	})



}



