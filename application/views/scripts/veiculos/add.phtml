	function showToastFipe(msg) {
		var el = document.getElementById("toast-fipe");
		if (!el) {
			el = document.createElement("div");
			el.id = "toast-fipe";
			el.className = "toast toast-erro";
			document.body.appendChild(el);
		}
		el.innerHTML = msg;
		el.className = "toast toast-erro toast-show";
		clearTimeout(el._t);
		el._t = setTimeout(function(){ el.className = "toast toast-erro toast-hide"; }, 5000);
	}

