function calculaValores(){



	valorAquisicao = moeda2float($("#valor_aquisicao").val());

	$("#valor_aquis").val(float2moeda(valorAquisicao));

	

	valorDespesas = calculaValordespesas();

	$("#total_despesa").val(float2moeda(valorDespesas));

	

	custoTotal = valorAquisicao+valorDespesas;

	$("#custo_total").val(float2moeda(custoTotal));

	

	valorVenda = moeda2float($("#valor_venda").val());

	$("#valor_vend").val(float2moeda(valorVenda));

	

	$("#lucro_esperado").val(float2moeda(valorVenda-custoTotal));



}



