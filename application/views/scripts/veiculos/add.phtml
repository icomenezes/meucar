	document.getElementById('foto').addEventListener('change', async function (event) {

		const files = event.target.files;

		const dataTransfer = new DataTransfer();

		const jpegInput = document.getElementById('foto');



		$('#images').html('<h2 style="padding: 5px; background-color: red; color: white;">Aguarde...</h2>');



		for (const file of files) {

			

			if(file.name.split(".").slice(-1) == "heic") {

				console.log(file.name.split(".").slice(-1)[0]);

		

				try {

					// Converte o arquivo HEIC para JPEG usando heic2any

					const convertedBlob = await heic2any({

						blob: file,

						toType: 'image/jpeg',

						quality: 1, // Qualidade do JPEG (0.0 a 1.0)

					});



					// Cria um novo arquivo Blob para representar o JPEG convertido

					const convertedFile = new File([convertedBlob], file.name.replace(/\.heic$/i, '.jpeg'), {

						type: 'image/jpeg',

					});



					// Adiciona o arquivo convertido ao input de arquivos



					dataTransfer.items.add(convertedFile);



					// Habilita o input convertido

					jpegInput.disabled = false;



				} catch (error) {

					console.error('Erro ao converter HEIC:', error);

					alert('Não foi possível converter o arquivo HEIC.');

				}



			}else{

				dataTransfer.items.add(file);

			}



		}



		jpegInput.files = dataTransfer.files;



		preview();



	});



