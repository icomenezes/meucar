function buscaFipe(string){



    console.log(string);



	segmento = $("#tipo").val();



	id_marca = $("#id_marca").val();



	id_modelos = $("#id_modelos").val();







	$.ajax({



		type: "POST",



        url:"/modelos/ajax",



        dataType:"json",



        data:{codigo_ano :string, marca_id:id_marca, modelo_id:id_modelos,tipo:segmento, fn:"fipe_precos"},



        success:function(retorno){

			if(retorno && retorno.fonte && retorno.fonte != "fipe") {
				if(retorno.fonte == "parallelum") showToastFipe("⚠️ FIPE indisponível. Preço via API alternativa (Parallelum).");
				if(retorno.fonte == "local")      showToastFipe("⚠️ APIs externas indisponíveis. Digite o valor FIPE manualmente.");
			}
			if(retorno && retorno.id) {
				$("#id_modelo").val(retorno.id);
				if(retorno.preco) $("#fipe").val(retorno.preco);
			} else {
				getIdModelo(retorno);
			}



        }



	});







}







function getIdModelo(retorno) {







	let tipo = $('#tipo option:selected').text().toLocaleLowerCase();



	let marca = $('#id_marca option:selected').text();



	let modelo = $('#id_modelos option:selected').text();



	let id_ano_modelo = $('#id_ano_modelo').val();





	$.ajax({



		type: "POST",



        url:"/modelos/ajax",



        dataType:"json",



        data:{



			ano_modelo_fipe: retorno.ano_modelo,



			codigo_fipe: retorno.codigo_fipe,



			combustivel: retorno.combustivel,



			valor: retorno.valor,



			tipo: tipo,



			marca_fipe: marca,



			modelo_fipe: modelo,



			id_ano_modelo: id_ano_modelo,



			fn:"get_modelo"



		},

        success:function(response){

            $("#id_modelo").val(response.id);

            $("#fipe").val(response.preco);



        }



	});



}







