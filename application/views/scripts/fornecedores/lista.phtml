<?php

	foreach($this->fornecedores as $f){
	
		$dataTmp = explode(" ",$f['hora_alteracao']);

		if(isset($dataTmp[0])){

			$dataTmp2 = explode("-",$dataTmp[0]);
			$f['hora_alteracao'] = implode("/",array_reverse($dataTmp2));
			if(isset($dataTmp[1])){
				$f['hora_alteracao'] = $f['hora_alteracao'] . " " . $dataTmp[1];
			}

		}
?>		
		<tr>
