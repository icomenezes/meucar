		<td><?php echo $f['ramo_atividade']?></td>
		<td><?php echo $f['contato']?></td>
		<td><?php echo $f['telefone']?></td>
		<td><?php echo ($f['ativo'] == "1") ? "Sim" : "N&atilde;o"; ?></td>
		<td><?php echo $f['obs']?></td>
		<td><?php echo $f['nome']." - ".$f['hora_alteracao']; ?></td>
		<td><input type="button" class="btn-small btn-edt" value="Editar" onclick="javascript:window.location.href='edt/id/<?php echo $f['id']?>'" /> <input type="button" class="btn-small btn-del" value="Delete" onclick="confirmaDelete('Fornecedor: <?php echo $f['razao_social']?>', <?php echo $f['id']?>)" /></td> </tr>
