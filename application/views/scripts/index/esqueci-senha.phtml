<?php
if(!$this->mensagem){
?>

<style type="text/css">
	.disabled { cursor: not-allowed; }
</style>

<p style="font-size:13px; color:#666; margin-bottom:20px;">Informe seu login e e-mail cadastrado para receber o link de redefinição.</p>

<div>
	<form method="post" action="/index/esqueci-senha" id="esqueci_senha">
		<div class="form-floating mb-3">
			<input type="text" class="form-control" id="user" name="user" placeholder="Login">
			<label for="user">Login</label>
		</div>
		<div class="form-floating mb-3">
			<input type="email" class="form-control" id="email" name="email" placeholder="E-mail">
			<label for="email">E-mail</label>
		</div>
		<div class="invalid-feedback msg">O login e e-mail devem ser informados.</div>
		<br>
		<?php if ($this->recaptchaEnabled): ?>
		<center>
			<div class="g-recaptcha" data-callback="enableBtn" data-sitekey="<?php echo $this->escape($this->recaptchaSitekey); ?>"></div>
		</center>
		<br>
		<div class="d-grid gap-2 disabled">
			<button class="btn btn-lg btn-primary" disabled="disabled" type="button" id="entrarButton">Enviar</button>
		</div>
		<?php else: ?>
		<div class="d-grid gap-2">
			<button class="btn btn-lg btn-primary" type="button" id="entrarButton">Enviar</button>
		</div>
		<?php endif; ?>
		<div class="d-grid gap-2" style="margin-top:12px;">
			<a href="/index/login-v2" class="btn btn-link" style="font-size:13px;">Voltar ao login</a>
		</div>
	</form>
</div>

<script type="text/javascript">


	function enableBtn(){
		$("#entrarButton").removeAttr("disabled");
		$("#disabled").removeClass("disabled");
	}

	$("#entrarButton").click(function(){

		$("#user").removeClass("is-invalid");
		$("#email").removeClass("is-invalid");
		$(".msg").css("display","none");

		let erro = false;

		if($("#user").val() == ""){
			erro = true;
			$("#user").addClass("is-invalid");
		}else{
			$("#user").addClass("is-valid");
		}

		if($("#email").val() == ""){
			erro = true;
			$("#email").addClass("is-invalid");
		}else{
			$("#email").addClass("is-valid");
		}

		if(erro){
			$(".msg").css("display","block");
		}else{
			$("#entrarButton").html("Aguarde...");
			$("#esqueci_senha").submit();
		}

	});

</script>

<?php
}else{
	echo $this->mensagem;
}
?>