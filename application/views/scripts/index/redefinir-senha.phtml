			<div class="erro" id="minuscula">Letra minúscula</div>
			<div class="erro" id="numero">Número</div>
			<div class="erro" id="caracteres">Caracter especial</div>
			<div class="erro" id="minimo_caracteres">Mínimo 8 caracteres</div>
			<div class="erro" id="iguais">Senhas iguais</div>
		</div>
		<?php if ($this->recaptchaEnabled): ?>
