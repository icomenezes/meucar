			<input type="password" class="form-control" id="senha1" name="senha1" placeholder="Nova senha" onkeyup="verificaSenha();">
			<label for="senha1">Nova senha</label>
		</div>
		<div class="form-floating mb-3">
			<input type="password" class="form-control" id="senha2" name="senha2" placeholder="Repita nova senha" onkeyup="verificaSenha();">
			<label for="senha2">Repita nova senha</label>
		</div>
