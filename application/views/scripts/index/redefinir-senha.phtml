<script type="text/javascript">

	var captcha = <?php echo $this->recaptchaEnabled ? 'false' : 'true'; ?>;

	function recaptchaExpired(){
		enableBtn();
	}

	function enableBtn(){
		captcha = captcha ? false : true;
		verificaSenha();
	}

	$("#salvarButton").click(function(){
		if(!verificaSenha()){
			$("#salvarButton").html("Aguarde...");
			$("#salvar_senha").submit();
		}
	});


	function verificaSenha(){

		let senha = $("#senha1").val();
		let erro = false;

		$("#senha1").removeClass("is-invalid");
		$("#senha2").removeClass("is-invalid");
		$("#senha1").removeClass("is-valid");
		$("#senha2").removeClass("is-valid");

		$("#salvarButton").attr("disabled", true);

		if(senha.match(/[A-Z]/g) != null){
			alteraClasse('maiuscula', true);
		}else{
			alteraClasse('maiuscula', false);
			erro = true;
		}

		if(senha.match(/[a-z]/g) != null){
			alteraClasse('minuscula', true);
		}else{
			alteraClasse('minuscula', false);
			erro = true;
		}

		if(senha.match(/[0-9]/g) != null){
			alteraClasse('numero', true);
		}else{
			alteraClasse('numero', false);
			erro = true;
		}

		if(senha.match(/[@ _.,;:#$%^&/]/g) != null){
			alteraClasse('caracteres', true);
		}else{
			alteraClasse('caracteres', false);
			erro = true;
		}

		if(senha.length >= 8){
			alteraClasse('minimo_caracteres', true);
		}else{
			alteraClasse('minimo_caracteres', false);
			erro = true;
		}

		if($("#senha1").val() == $("#senha2").val()){
			alteraClasse('iguais', true);
		}else{
			alteraClasse('iguais', false);
			erro = true;
		}

		if(erro){
			$("#senha1").addClass("is-invalid");
			$("#senha2").addClass("is-invalid");
		}else{
			$("#senha1").addClass("is-valid");
			$("#senha2").addClass("is-valid");

			if(captcha){
				$("#salvarButton").attr("disabled", false);
			}
		}

		return erro;

	}

	function alteraClasse(id, valid){
		if(valid){
			$("#"+id).removeClass("erro");
			$("#"+id).addClass("sucesso");
		}else{
			$("#"+id).removeClass("sucesso");
			$("#"+id).addClass("erro");
		}
	}

	$("#verSenha").click(function(){
		if($( "#verSenha" ).prop("checked")){
			$('#senha1').get(0).type = 'text';
			$('#senha2').get(0).type = 'text';
		}else{
			$('#senha1').get(0).type = 'password';
			$('#senha2').get(0).type = 'password';
		}
	});

</script>

