			<div class="g-recaptcha" data-callback="enableBtn" data-expired-callback="recaptchaExpired" data-sitekey="<?php echo $this->escape($this->recaptchaSitekey); ?>"></div>
		</center>
		<br>
		<?php endif; ?>
		<input type="hidden" name="not-secret" value="<?php echo $_GET['u']; ?>">
