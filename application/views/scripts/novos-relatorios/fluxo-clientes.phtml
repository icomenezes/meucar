	function acents(string){
		
		string = string.replace('"','').replace('"','').replace('"','').replace('&atilde;','ã').replace('&atilde;','ã').replace('&otilde;','õ').replace('&otilde;','õ');
		string = string.replace('&ccedil;','ç').replace('&aacute;','á').replace('&eacute;','é').replace('&iacute;','í').replace('&oacute;','ó').replace('&uacute;','ú');
		string = string.replace('&ccedil;','ç').replace('&aacute;','á').replace('&eacute;','é').replace('&iacute;','í').replace('&oacute;','ó').replace('&uacute;','ú');
		string = string.replace('&acirc;','â').replace('&ecirc;','ê');
		string = string.replace('&acirc;','â').replace('&ecirc;','ê');
		
		return string;
		
	}
	
