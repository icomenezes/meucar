<script type="text/javascript">

	function mudaParcelas(ano){
	
		var anoLimite = <?php echo (@date("Y")-7); ?>;
		
		if(ano < anoLimite){
		
			$("#numero_parcelas").html("<option value=''>Selecione</option><option value='12'>12 - Parcelas</option><option value='24'>24 - Parcelas</option><option value='36'>36 - Parcelas</option><option value='48'>48 - Parcelas</option>");
		
		}else{
		
			$("#numero_parcelas").html("<option value=''>Selecione</option><option value='12'>12 - Parcelas</option><option value='24'>24 - Parcelas</option><option value='36'>36 - Parcelas</option><option value='48'>48 - Parcelas</option><option value='60'>60 - Parcelas</option>");
		
		}
	
	}

	function validaCampo(){
	
		var msg = "";
		var erro = false;
		
		if($("#ano_modelo").val() == ""){
			
			erro = true;
		
		}
		
		if($("#numero_parcelas").val() == ""){
			
			erro = true;
		
		}
		
		if($("#entrada").val() == ""){
			
			erro = true;
		
		}
		
		if($("#parcelas").val() == ""){
			
			erro = true;
		
		}
		
		if(erro){
		
			alert("Os campos marcados com '*' devem ser selecionados");
		
		}else{
		
			$("#simular").submit();
		
		}
		
	}
	
