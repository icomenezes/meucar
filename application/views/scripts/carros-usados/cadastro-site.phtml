	function preencheLogin(){
	
		$("#login").val($("#email").val());
	
	}
	
	function confirmaSenha(){
	
		if($("#senha").val() != $("#senha2").val()){
		
			$("#status_senha").html("&nbsp;<br><b>Senhas diferentes</b>");
			$("#status_senha").css("color","red");
			
			return false;
		
		}else{
		
			$("#status_senha").html("&nbsp;<br><b>Senha válida</b>");
			$("#status_senha").css("color","green");
			
			return true;
		
		}
		
	}
	
	$(function(){
	
		$("#submit").live('click', function(){
	
			$("#cadastro_site").submit();
	
		});
	
		$("#cep").mask("99999-999");
		$("#rg").mask("99.999.99?9-*");
		$("#cpf").mask("999.999.999-99");
		
		$('#celular').focusout(function(){
		var phone, element;
		element = $(this);
		element.unmask();
		phone = element.val().replace(/\D/g, '');
		if(phone.length > 10) {
			element.mask("(99) 99999-999?9");
		} else {
			element.mask("(99) 9999-9999?9");
		}
		}).trigger('focusout');
		
		$('#telefone').focusout(function(){
		var phone, element;
		element = $(this);
		element.unmask();
		phone = element.val().replace(/\D/g, '');
		if(phone.length > 10) {
			element.mask("(99) 99999-999?9");
		} else {
			element.mask("(99) 9999-9999?9");
		}
		}).trigger('focusout');
		
	});
	
	function abrirPopup(pagina,largura,altura) {

		w = screen.width;
		h = screen.height;
		meio_w = w/2;
		meio_h = h/2;
		altura2 = altura/2;
		largura2 = largura/2;
		meio1 = meio_h-altura2;
		meio2 = meio_w-largura2;
		window.open(pagina,'','scrollbars=no,toolbar=no,location=no,directories=no,status=no, menubar=no,resizable=no,copyhistory=no,height=' + altura + ',width=' + largura + ',top='+meio1+',left='+meio2+''); 

	}
	
