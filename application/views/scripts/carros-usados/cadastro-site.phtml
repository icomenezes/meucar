<script type="text/javascript">

	$("#menu_busca").remove();
	
	function validaCampo(){
		
		var confirm = true;
		
		if($("#nome").val() == ""){
		
			$("#nome").css("border-color","red");
			confirm = false;
		
		}else{
		
			$("#nome").css("border","solid 1px");
			$("#nome").css("border-color","silver");
		
		}
		
		if($("#email").val() == ""){
		
			$("#email").css("border-color","red");
			confirm = false;
		
		}else{
		
			$("#email").css("border","solid 1px");
			$("#email").css("border-color","silver");
		
		}
		
		if($("#cpf").val() == ""){
		
			$("#cpf").css("border-color","red");
			confirm = false;
		
		}else{
		
			$("#cpf").css("border","solid 1px");
			$("#cpf").css("border-color","silver");
		
		}
		
		if($("#rg").val() == ""){
		
			$("#rg").css("border-color","red");
			confirm = false;
		
		}else{
		
			$("#rg").css("border","solid 1px");
			$("#rg").css("border-color","silver");
		
		}
		
		if($("#endereco").val() == ""){
		
			$("#endereco").css("border-color","red");
			confirm = false;
		
		}else{
		
			$("#endereco").css("border","solid 1px");
			$("#endereco").css("border-color","silver");
		
		}
		
		if($("#bairro").val() == ""){
		
			$("#bairro").css("border-color","red");
			confirm = false;
		
		}else{
		
			$("#bairro").css("border","solid 1px");
			$("#bairro").css("border-color","silver");
		
		}
		
		if($("#cidade").val() == ""){
		
			$("#cidade").css("border-color","red");
			confirm = false;
		
		}else{
		
			$("#cidade").css("border","solid 1px");
			$("#cidade").css("border-color","silver");
		
		}
		
		if($("#estado").val() == ""){
		
			$("#estado").css("border-color","red");
			confirm = false;
		
		}else{
		
			$("#estado").css("border","solid 1px");
			$("#estado").css("border-color","silver");
		
		}
		
		if($("#telefone").val() == ""){
		
			$("#telefone").css("border-color","red");
			confirm = false;
		
		}else{
		
			$("#telefone").css("border","solid 1px");
			$("#telefone").css("border-color","silver");
		
		}
		
		if($("#celular").val() == ""){
		
			$("#celular").css("border-color","red");
			confirm = false;
		
		}else{
		
			$("#celular").css("border","solid 1px");
			$("#celular").css("border-color","silver");
		
		}
		
		if($("#login").val() == ""){
		
			$("#login").css("border-color","red");
			confirm = false;
		
		}else{
		
			$("#login").css("border","solid 1px");
			$("#login").css("border-color","silver");
		
		}
		
		if($("#senha").val() == ""){
		
			$("#senha").css("border-color","red");
			confirm = false;
		
		}else{
		
			$("#senha").css("border","solid 1px");
			$("#senha").css("border-color","silver");
		
		}
		
		if($("#senha2").val() == ""){
		
			$("#senha2").css("border-color","red");
			confirm = false;
		
		}else{
		
			$("#senha2").css("border","solid 1px");
			$("#senha2").css("border-color","silver");
		
		}
		
		if($("#aceito").attr("checked") != "checked"){
		
			confirm = false;
			alert("É necessário aceitar os termos de uso para seguir com o cadastro!");
		
		}
		
		if(confirm){
			
			if(confirmaSenha()){
				
				$("#botao").html("<form target='pagseguro' action='https://pagseguro.uol.com.br/checkout/v2/payment.html' method='post'><input type='hidden' name='code' value='A800D378EBEBB07334A2FF96633E21F4' /><input type='image' src='https://p.simg.uol.com.br/out/pagseguro/i/botoes/pagamentos/94x52-pagar-assina.gif' name='submit' id='submit' alt='Pague com PagSeguro - é rápido, grátis e seguro!' /></form>");

			}else{
				
				$("#mensagem").html("&nbsp;Senhas est&atilde;o incorretas.");
				$("#mensagem").css("display","block");
				$("#mensagem").css("background-color","red");
				$("#mensagem").css("color","white");
			
			}
		
		}else{
			
			$("#mensagem").html("&nbsp;Os campos marcados em vermelho s&atilde;o de preenchimento obrigat&oacute;rio.");
