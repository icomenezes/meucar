					<div class="d-flex justify-content-center gap-3">
						<a href="javascript:history.back();" class="btn btn-outline-secondary btn-lg">Voltar</a>
						<a href="/" class="btn btn-primary btn-lg">P&aacute;gina inicial</a>
					</div>

					<?php if (isset($this->exception)): ?>
					<div class="debug-section">
						<hr>
						<span class="debug-toggle" onclick="document.getElementById('debugInfo').style.display = document.getElementById('debugInfo').style.display === 'none' ? 'block' : 'none';">
							Detalhes t&eacute;cnicos (clique para expandir)
						</span>
						<div id="debugInfo" style="display:none; margin-top:15px;">
							<div class="alert alert-danger text-start" role="alert">
								<strong>Mensagem:</strong> <?php echo $this->escape($this->exception->getMessage()); ?>
							</div>
							<h6 class="text-start">Rastreamento:</h6>
							<pre><?php echo $this->escape($this->exception->getTraceAsString()); ?></pre>
							<h6 class="text-start">Par&acirc;metros da requisi&ccedil;&atilde;o:</h6>
							<pre><?php echo $this->escape(var_export($this->request->getParams(), true)); ?></pre>
						</div>
					</div>
					<?php endif; ?>

				<?php endif; ?>

			</div>
		</div>
	</div>

