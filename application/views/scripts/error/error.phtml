<!DOCTYPE html>
<html lang="pt-BR">
<head>
	<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<meta name="theme-color" content="#aa0000">
	<title>Meu Car - Erro</title>
	<link rel="stylesheet" href="/css/loginv2/bootstrap.css" type="text/css" media="screen" />
	<script type="text/javascript" src="/js/jquery-3.4.2.min.js"></script>
	<style>
		body {
			background-color: #f5f5f5;
		}
		.error-container {
			margin-top: 80px;
		}
		.error-code {
			font-size: 72px;
			font-weight: 700;
			color: #343a40;
			margin-bottom: 0;
		}
		.error-message {
			font-size: 18px;
			color: #6c757d;
			margin-bottom: 30px;
		}
		.debug-section {
			text-align: left;
			margin-top: 40px;
		}
		.debug-section pre {
			background: #f8f9fa;
			border: 1px solid #dee2e6;
			border-radius: 4px;
			padding: 15px;
			font-size: 12px;
			max-height: 300px;
			overflow-y: auto;
			word-wrap: break-word;
			white-space: pre-wrap;
		}
		.debug-toggle {
			cursor: pointer;
			color: #6c757d;
			font-size: 13px;
			text-decoration: underline;
		}
		.report-section {
			margin-top: 25px;
		}
	</style>
</head>
<body>

	<nav class="navbar navbar-expand-lg navbar-dark bg-primary">
		<div class="container-fluid">
			<a class="navbar-brand" href="/">Meu Car</a>
		</div>
	</nav>

	<div class="container error-container">
		<div class="row justify-content-center">
			<div class="col-lg-6 col-md-8 text-center">

				<?php if ($this->message == '404'): ?>

					<div class="error-code">404</div>
					<div class="error-message">
						P&aacute;gina n&atilde;o encontrada.<br>
						<small>Verifique o endere&ccedil;o e tente novamente.</small>
					</div>
					<a href="/" class="btn btn-primary btn-lg">Voltar ao in&iacute;cio</a>

				<?php else: ?>

					<div class="error-code">500</div>
					<div class="error-message">
						Ocorreu um erro inesperado.<br>
						<small>Por favor, tente novamente. Se o problema persistir, clique em "Reportar erro".</small>
					</div>
					<div class="d-flex justify-content-center gap-3">
						<a href="javascript:history.back();" class="btn btn-outline-secondary btn-lg">Voltar</a>
						<a href="/" class="btn btn-primary btn-lg">P&aacute;gina inicial</a>
					</div>

					<?php if (isset($this->errorData)): ?>
					<div class="report-section">
						<hr>
						<p class="text-muted">Deseja informar o suporte sobre este erro?</p>
						<div class="mb-3">
							<textarea class="form-control" id="observacao" rows="2" placeholder="Descreva o que estava fazendo quando o erro ocorreu (opcional)"></textarea>
						</div>
						<button class="btn btn-danger" id="btnReportar" onclick="reportarErro()">
							Reportar erro
						</button>
						<div id="reportResult" class="mt-3" style="display:none;"></div>
					</div>
					<?php endif; ?>

					<?php if (isset($this->exception)): ?>
					<div class="debug-section">
						<hr>
						<span class="debug-toggle" onclick="document.getElementById('debugInfo').style.display = document.getElementById('debugInfo').style.display === 'none' ? 'block' : 'none';">
							Detalhes t&eacute;cnicos (clique para expandir)
						</span>
						<div id="debugInfo" style="display:none; margin-top:15px;">
							<div class="alert alert-danger text-start" role="alert">
								<strong>Mensagem:</strong> <?php echo $this->escape($this->exception->getMessage()); ?>
							</div>
							<h6 class="text-start">Rastreamento:</h6>
							<pre><?php echo $this->escape($this->exception->getTraceAsString()); ?></pre>
							<h6 class="text-start">Par&acirc;metros da requisi&ccedil;&atilde;o:</h6>
							<pre><?php echo $this->escape(var_export($this->request->getParams(), true)); ?></pre>
						</div>
					</div>
					<?php endif; ?>

				<?php endif; ?>

			</div>
		</div>
	</div>

	<?php if (isset($this->errorData)): ?>
	<script>
	function reportarErro() {
		var btn = $("#btnReportar");
		var result = $("#reportResult");

		btn.prop("disabled", true).html("Enviando...");
		result.hide();

		$.ajax({
			type: "POST",
			url: "/error/report",
			dataType: "json",
			data: {
				error_data: "<?php echo $this->errorData; ?>",
				observacao: $("#observacao").val()
			},
			success: function(resp) {
				if (resp.success) {
					result.html('<div class="alert alert-success">' + resp.msg + '</div>').show();
					btn.html("Enviado!").addClass("btn-success").removeClass("btn-danger");
				} else {
					result.html('<div class="alert alert-warning">' + resp.msg + '</div>').show();
					btn.prop("disabled", false).html("Tentar novamente");
				}
			},
			error: function() {
				result.html('<div class="alert alert-warning">Falha ao enviar. Tente novamente.</div>').show();
				btn.prop("disabled", false).html("Tentar novamente");
			}
		});
	}
	</script>
	<?php endif; ?>

</body>
</html>