			+"</div>");
			$("#fundo_escuro").fadeIn('slow');
			
			setTimeout(function(){
				$(".fundo_escuro").remove();
			}, 2000);

			return false;
		}
	
	}
	
	$.ajax({
		type: "POST",
		url: '/clientes/ajax/fn/verifica_cpf',
		async: true,
		dataType:"text",
		data: ({'cpf':valor}),
		success:function(resp){
			
			if(resp != ""){
			
				$("#container").prepend("<div id='fundo_escuro' style='font-weight: bold; z-index:1; position:absolute; width:100%; height:"+$(document).height()+"px; opacity:0.80; background-color:#000; display:none; text-align:center;'>"
					+"<div style='margin-top:"+$(window).height()/2+"px; z-index:999; color:red; font-size:15px; border: solid 0px; opacity: 3; background-color:#FFF;'><br/>O "+$('#cpf_label').html()+" informado já está cadastrado no sistema!<br/>"
