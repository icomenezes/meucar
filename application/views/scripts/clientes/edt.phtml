				+"</div>");
				$("#fundo_escuro").fadeIn('slow');
			
			}
			
		}
			
	});

}


function mudaDocumento(id){

	var ids = new Array();
	ids = id.split("_");
	
	if(ids[2] == "cpf"){
	
		$("#cpf").mask("999.999.999-99");
		$("#cpf_label").html("CPF");
		$("#rg").mask("99.999.99?9-*");
		$("#rg_label").html("RG");
	
	}
	
	if(ids[2] == "cnpj"){
	
		$("#cpf").mask("99.999.999/9999-99");
		$("#cpf_label").html("CNPJ");
		$("#rg").unmask();
		$("#rg_label").html("I.E.");
	
	}

}

