	valorTemp = valorTemp.replace(".","");
	valorTemp = valorTemp.replace("_","");
	valorTemp = valorTemp.replace("_","");
	valorTemp = valorTemp.replace("_","");
	valorTemp = valorTemp.replace("_","");
	valorTemp = valorTemp.replace("_","");
	valorTemp = valorTemp.replace("_","");
	valorTemp = valorTemp.replace("_","");
	valorTemp = valorTemp.replace("_","");
	valorTemp = valorTemp.replace("_","");
	valorTemp = valorTemp.replace("_","");
	valorTemp = valorTemp.replace("_","");
	
	
	if(valorTemp.length != 11){
		return false;
	}
	
	if($("#cpf_label").html() == "CPF"){

		if(valor == "___.___.___-__" || valor == ""){
			return false;
		}

		if(!validaCPF(valorTemp)){
