			$("#id_negociacoes_compra").html(resp);
		
		}
		
	});
	

}

var primeiro = "0";

function buscaCliente(id){

	$.ajax({
		type: "POST",
		url: '/clientes/ajax/fn/busca_cliente',
		async: true,
		dataType:"text",
		data: ({'id_cliente':id}),
		success:function(resp){
	
			arrTemp = resp.split("|-|");
			
			for(x in arrTemp){
				
				arr = arrTemp[x].split("|");
				
				val = String(arr[1]);
				
				if(val != "" && val != "undefined"){
				
					if(val.charAt(4) == "-" && val.charAt(7) == "-" && val.length == 10){
						
						val = val.substring(8,10)+"/"+val.substring(5,7)+"/"+val.substring(0,4);
						
					}

					if($("#"+arr[0]).attr("type") == "checkbox" && val == "1"){
						
						$("#"+arr[0]).attr("checked", true);
						$("#"+arr[0]).val(1);

					}else{
					
						if(arr[0] ==  "id"){
							
							$("#id_cliente").val(val);
						
						}else{
					
							$("#"+arr[0]).val(val);
							
						}
						
					}
				
				}

			}
			
		}
			
	});

}

function validaCPF(cpf)
  {
    var numeros, digitos, soma, i, resultado, digitos_iguais;
    digitos_iguais = 1;
    if (cpf.length < 11)
          return false;
    for (i = 0; i < cpf.length - 1; i++)
          if (cpf.charAt(i) != cpf.charAt(i + 1))
                {
                digitos_iguais = 0;
                break;
                }
    if (!digitos_iguais)
          {
          numeros = cpf.substring(0,9);
          digitos = cpf.substring(9);
          soma = 0;
          for (i = 10; i > 1; i--)
                soma += numeros.charAt(10 - i) * i;
          resultado = soma % 11 < 2 ? 0 : 11 - soma % 11;
          if (resultado != digitos.charAt(0))
                return false;
          numeros = cpf.substring(0,10);
          soma = 0;
          for (i = 11; i > 1; i--)
                soma += numeros.charAt(11 - i) * i;
          resultado = soma % 11 < 2 ? 0 : 11 - soma % 11;
          if (resultado != digitos.charAt(1))
                return false;
          return true;
          }
    else
        return false;
  }

