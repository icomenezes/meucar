<script type="text/javascript">

function mudaDocumento(id){

	var ids = new Array();
	ids = id.split("_");
	
	if(ids[2] == "cpf"){
	
		$("#cpf").mask("999.999.999-99");
		$("#cpf_label").html("CPF");
		$("#rg").mask("99.999.99?9-*");
		$("#rg_label").html("RG");
	
	}
	
	if(ids[2] == "cnpj"){
	
		$("#cpf").mask("99.999.999/9999-99");
		$("#cpf_label").html("CNPJ");
		$("#rg").unmask();
		$("#rg_label").html("I.E.");
	
	}

}

function printDiv(){

	$("#form").attr("action", "<?php echo URL ?>clientes/impressao/id/<?php echo $this->id ?>");
	$("#form").attr("target","_blank");
	$("#form").submit();
	
	$("#form").attr("action", "<?php echo URL ?>clientes/edt/id/<?php echo $this->id ?>");
	$("#form").attr("target","");
	
}


function validaCampo(){

	var msg = "";
	var erro = false;
	
	if($("#nome").val() == ""){
		
		erro = true;
		
		msg += "<br>O campo nome deve ser preenchido.";
	
	}
	
	if($("#cpf").val() == ""){
		
		erro = true;
		
		msg += "<br>O campo CPF deve ser preenchido.";
	
	}
	
	if($("#tel1").val() == ""){
		
		erro = true;
		
		msg += "<br>O campo telefone deve ser preenchido.";
	
	}
	
	if($("#nascimento").val() == ""){
		
		erro = true;
		
		msg += "<br>O campo nascimento deve ser preenchido.";
	
	}
	
	if($("#email").val() == ""){
		
		erro = true;
		
		msg += "<br>O campo email deve ser preenchido.";
	
	}
	
	if(erro){
		
		msg = msg.substr(4);
		$("#msg").removeClass('sucess');
		$("#msg").addClass('erro');
		$("#msg").html(msg);
	
	}else{
		
		$("form").submit();
		return true;
	
	}

}

