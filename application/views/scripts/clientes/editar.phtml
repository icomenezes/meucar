	function buscaCep(cep, rua, bairro, cidade, estado, foco){

		if(cep.charAt(8) != "_"){
	
			$.ajax({
				url : '/clientes/ajax/fn/busca_cep/cep/'+cep,
				type : 'POST',
				dataType: 'json',
				success: function(data){

					if(data.sucesso == "1"){
					
						$("#"+rua).val(data.rua);
						$("#"+bairro).val(data.bairro);
						$("#"+cidade).val(data.cidade);
						$("#"+estado).val(data.estado);
	 
						$("#"+foco).focus();

					}
				}
			});
		
		}
 
	}
