<script type="text/javascript">
	
	var arrTextoEmail = new Array();
	var arrTituloEmail = new Array();
	var whatsapp = false;
	var num = "";
	
	

	
	function enviaWhatsapp(){

		var userAgent = navigator.userAgent.toLowerCase();
	
		if( userAgent.search(/(android|avantgo|blackberry|bolt|boost|cricket|docomo|fone|hiptop|mini|mobi|palm|phone|pie|tablet|up\.browser|up\.link|webos|wos)/i)!= -1 ){
			window.open("whatsapp://send?phone=55"+num.replace('(','').replace(')','').replace(' ','').replace('-','')+"&text="+$("#msg_email").val(), "_blank");
		}else{
			window.open("http://web.whatsapp.com/send?phone=55"+num.replace('(','').replace(')','').replace(' ','').replace('-','')+"&text="+$("#msg_email").val(), "_blank");
		}

		logContatoWhatsApp();
		$('#area_email').css('display','none');
		
	}
	
	
	function abreCampoEmail(id){
		
		if($('#id_cliente_fluxo').val() != ''){
			if(id == "bnt_email"){
				$('#msg_email').val('');
				$('#area_email').css('display','block');
				$('#area_email').children().first().html("E-mail");
				$("#bnt_enviar").attr("onclick","enviaEmail(); $('#area_email').css('display','none'); $('#texto_email').val(''); $('#titulo').val(''); $('#id_modelo_email').val('');");
				$("#bnt_enviar").attr("class","btn-small btn-enviar-email");
				getModeloEmail();
			}
			if(id == "bnt_whatsapp"){
				$('#msg_email').val('');
				$('#area_email').css('display','block');
				$('#area_email').children().first().html("WhatsApp");
				$("#bnt_enviar").attr("onclick","enviaWhatsapp();");
				$("#bnt_enviar").attr("class","btn-small btn-whatsapp");
				getModeloEmail();
			}
		}else{
			alert('É necessário salvar o contato para enviar o e-mail.');
		}
		
	}
	
	function getTextoEmail(id){
		
		$("#msg_email").val(arrTextoEmail[id]);

		if(id != ""){
			$("#btn_edt_modelo").val("Editar");
			$("#btn_edt_modelo").attr("class","btn-small btn-edt");
		}else{
			$("#btn_edt_modelo").val("Adicionar");
			$("#btn_edt_modelo").attr("class","btn-small btn-include");
		}
		
	}

	function getModeloEmail(){
		
		$.ajax({
			type: "POST",
			url: '/emails/ajax/fn/get_modelos_emails',
			async: true,
			dataType:"text",
			success:function(resp){

				var str = "<option value=''>Selecione</option>";

				arrTemp = resp.split('||');

				for(x in arrTemp){
					arrTempDois = arrTemp[x].split('|');
					
					str += "<option value='"+arrTempDois[0]+"'>"+arrTempDois[1]+"</option>";
					
					arrTextoEmail[arrTempDois[0]] = arrTempDois[2];
					arrTituloEmail[arrTempDois[0]] = arrTempDois[1];
					
				}
				
				$("#modelos_email").html(str);
				
			}

		});
		
	}

	function salvaTextoEmail(){
		
		if($("#titulo").val() != "" && $("#texto_email").val() != ""){
		
			$.ajax({
				type: "POST",
				url: '/emails/ajax/fn/modelo_email',
				async: true,
				dataType:"text",
				data: ({'id':$("#id_modelo_email").val(), 'titulo':$("#titulo").val(), 'texto':$("#texto_email").val()}),
				success:function(resp){

					if(resp == "sucesso"){
						alert("Modelo salvo com sucesso!");
					}else{
						alert(resp);
					}

				}

			});
		
		}
		
	}


	function logContatoWhatsApp(){
		
		if($("#id_cliente_fluxo").val()){

			$.ajax({
				type: "POST",
				url: '/clientes/ajax/fn/log_whatsapp',
				async: true,
				dataType:"text",
				data: ({'id_cliente_fluxo':$("#id_cliente_fluxo").val(), 'mensagem':$("#msg_email").val()}),
				success:function(resp){
					
					if(resp){
						$("#atividades").val(resp);
						scrollBaixo();
					}

				}

			});
			
		}
		
	}


	function verificaCelular(){
		
		$("#bnt_whatsapp").css("display","none");
		var whatsapp = false;
		num = $("#telefone").val();
		
		if(num != ""){
			var arrUm = num.split(" ");
			var arrDois = arrUm[1].split("-");
			
			if(arrDois[0].length == 5){
				
				if(arrDois[0].slice(0,1) == 9){

					whatsapp = true;

				}
				
			}else{
				
				if(arrDois[0].length == 4){
				
					if(arrDois[0].slice(0,1) == 9 || arrDois[0].slice(0,1) == 8 || arrDois[0].slice(0,1) == 7){
						
						whatsapp = true;

					}
				
				}
				
			}
			
		}
		
		
		if(!whatsapp){
			
			num = "";
		
			num = $("#telefone2").val();
			
			if(num != ""){
				var arrUm = num.split(" ");
				var arrDois = arrUm[1].split("-");
				
				if(arrDois[0].length == 5){
					if(arrDois[0].slice(0,1) == 9){
						
						whatsapp = true;

					}
					
				}else{
					
					if(arrDois[0].length == 4){
					
						if(arrDois[0].slice(0,1) == 9 || arrDois[0].slice(0,1) == 8 || arrDois[0].slice(0,1) == 7){
							
							whatsapp = true;

						}
					
					}
					
				}
				
			}
			
		}
		
		if(!whatsapp){
			
			num = "";
		
			num = $("#celular").val();
			
			if(num != ""){
				var arrUm = num.split(" ");
				var arrDois = arrUm[1].split("-");
				
				if(arrDois[0].length == 5){
					if(arrDois[0].slice(0,1) == 9){
						
						whatsapp = true;

					}
					
				}else{
					
					if(arrDois[0].length == 4){
					
						if(arrDois[0].slice(0,1) == 9 || arrDois[0].slice(0,1) == 8 || arrDois[0].slice(0,1) == 7){

							whatsapp = true;

						}
					
					}
					
				}
				
			}
			
		}
		/*
		if(whatsapp){

			var userAgent = navigator.userAgent.toLowerCase();
	
			if( userAgent.search(/(android|avantgo|blackberry|bolt|boost|cricket|docomo|fone|hiptop|mini|mobi|palm|phone|pie|tablet|up\.browser|up\.link|webos|wos)/i)!= -1 ){
				$("#bnt_whatsapp").css("display","inline");
			}else{
				$("#bnt_whatsapp").css("display","inline");
			}

		}
		*/
	}

	function enviaEmail(){

		if($("#msg_email").val() == ""){
			alert("O texto do e-mail não pode ser vazio!");
		}else{
		
			if($("#id_cliente_fluxo").val() != ""){
				
				$("body").prepend('<div id="div_aguarde" style="text-align:center; opacity:0.8; background-color:#000;width:100%; height:1000px; position:fixed; font-size: 30px; color:#fff;"><div style="margin-top:200px;">Enviando! Aguarde...</div></div>');
				
				$.ajax({
					type: "POST",
					url: '/emails/ajax/fn/email_fluxo',
					async: true,
					dataType:"text",
					data: ({'email':$("#email").val(), 'mensagem':$("#msg_email").val(), 'id_cliente_fluxo':$("#id_cliente_fluxo").val()}),
					success:function(resp){
						if(resp != "Erro"){
							$("#atividades").val(resp);
							$("#div_aguarde").remove();
							$("body").prepend('<div id="div_aguarde" style="text-align:center; opacity:0.8; background-color:#000;width:100%; height:1000px; position:fixed; font-size: 30px; color:#fff;"><div style="margin-top:200px;">Enviando com sucesso!</div></div>');
							$("#div_aguarde").fadeOut(2000);
							scrollBaixo();

						}
					}

				});
				
			}
		
		}
		
	}

