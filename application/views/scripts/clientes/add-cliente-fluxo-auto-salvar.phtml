	function agendaContato(cancelar){
		
		if($("#id_cliente_fluxo").val()){
			
			if(cancelar == false && $('#btn_agendar').attr("value") != "Agendar"){
				var data = $('#btn_agendar').attr("value");
				$("#resultado").val('Agendado');
				$("#resultado").css({'background-color':'#eee','color':'#555'});
				$("#resultado").attr('disabled','disabled');
				$("#resultado").parent().attr('title','Para alterar o resultado é necessário cancelar o agendamento.');
				validaCampo();
			}else{
				if(cancelar == true && $('#btn_agendar').attr("value") == "Agendar"){
					var data = "";
					$("#resultado").val('Negociação');
					$("#resultado").css({'background-color':'yellow','color':'#333'});
					$("#resultado").attr('disabled',false);
					$("#resultado").parent().attr('title','Selecione o resultado.');
					validaCampo();
				}
			}

			$.ajax({
				type: "POST",
				url: '/clientes/ajax/fn/agenda_contato',
				async: true,
				dataType:"text",
				data: ({'id_cliente_fluxo':$("#id_cliente_fluxo").val(), 'data':data}),
				success:function(resp){
					
					if(resp){
						$("#atividades").val(resp);
						scrollBaixo();
					}

				}

			});
			
		}
		
	}
	
