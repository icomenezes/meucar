	function validaCampo(){

		var msg = "";
		var erros = false;
		
		
		if($("#nome").val() == ""){
			
			erros = true;
			msg += "O campo 'Nome' deve ser preenchido.<br/>";

		}
		
		if($("#data").val() == ""){
			
			erros = true;
			msg += "O campo 'Data' deve ser preenchido.<br/>";

		}
		
		if($("#origem").val() == ""){
			
			erros = true;
			msg += "O campo 'Origem' deve ser selecionado.<br/>";

		}
		
		if($("#telefone").val() == ""){
			
			erros = true;
			msg += "O campo 'Telefone' deve ser preenchido.<br/>";

		}
		
		if($("#id_vendedor").val() == ""){
			
			erros = true;
			msg += "O campo 'Vendedor' deve ser selecionado.<br/>";

		}
		
		if($("#resultado").val() == ""){
			
			erros = true;
			msg += "O campo 'Resultado' deve ser selecionado.<br/>";

		}
		
		if($("#resultado").val() == "Desistiu" || $("#resultado").val() == "Concorrente"){
			
			if($("#motivo_pre").val() == ""){
			
				erros = true;
				msg += "O campo 'Motivo' deve ser selecionado.<br/>";
				
			}
			
			if($("#motivo_pre").val() == 1){

				if($("#motivo").val() == ""){
				
					erros = true;
					msg += "O campo 'Descrição do motivo' deve ser preenchido.<br/>";
					
